#!/bin/sh
[ -f /etc/banner ] && cat /etc/banner
echo -n "time='"$(date '+%A %d/%m/%Y %H:%M:%S')"'"
batctl hp > /dev/null 2>&1 && echo -n " - HopPenalty='$(batctl hp|tr -d "\n")'"
echo " - uptime='$(uptime|sed -e 's/^\ //1' -e 's/\ \ //g')'"
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export HOME=$(grep -e "^${USER:-root}:" /etc/passwd | cut -d ":" -f 6)
export HOME=${HOME:-/root}
export PS1='\u@\h:\w\$ '
[ -x /bin/more ] || alias more=less
[ -x /usr/bin/vim ] && alias vi=vim || alias vim=vi
[ -z "$KSH_VERSION" -o \! -s /etc/mkshrc ] || . /etc/mkshrc
[ -x /usr/bin/arp ] || arp() { cat /proc/net/arp; }
[ -x /usr/bin/ldd ] || ldd() { LD_TRACE_LOADED_OBJECTS=1 $*; }
batctl gwl
export imagename=$(lua -e 'print(require("platform_info").get_image_name())')
U="$(uci show 2>/dev/null)"   # einmal lesen statt ~15 uci-Aufrufe (Login auf 4/32 dauerte 2 s)
export MoLoff=$(echo "$U"|grep network.mesh_lan.disabled|cut -d"=" -f2)
export MoWoff=$(echo "$U"|grep network.mesh_wan.disabled|cut -d"=" -f2)
export ifMoL=$(echo "$U"|grep network.mesh_lan.ifname|cut -d"=" -f2)
export ifWAN=$(echo "$U"|grep network.wan.ifname|cut -d"=" -f2)
export ifCLI=$(echo "$U"|grep network.client.ifname|cut -d"=" -f2)
export lanCLI=\'$(echo $ifCLI|sed -r 's/.*(eth[0-9.]{1,3}).*/\1/g'|grep eth)\'
export batgw=$(batctl gwl|grep ^*|cut -d"[" -f2|cut -d"]" -f1)
export VPNon="'0'"
[ "$(echo "$U"|grep gluon.mesh_vpn.enabled|cut -d"=" -f2)" == "'1'" ] && export VPNon="'1'"
[ "$(echo "$U"|grep tunneldigger.mesh_vpn.enabled|cut -d"=" -f2)" == "'1'" ] &&  export VPNon="'1'"
echo firmware=\'$(cat /lib/gluon/release)\'-\'$(cat /lib/gluon/gluon-version)\' autoupdater=$(echo "$U"|grep autoupdater.settings.enabled|cut -d"=" -f2) branch=$(echo "$U"|grep autoupdater.settings.branch|cut -d"=" -f2)
echo vpn=$VPNon:$(echo "$U"|grep tunneldigger.mesh_vpn.enabled|cut -d"=" -f2|sed -e "s/'1'/l2tp/"|sed -e "s/'0'/l2tp_off/") $(echo "$U"|grep fastd.mesh_vpn.enabled|cut -d"=" -f2|sed -e "s/'1'/fastd/"|sed -e "s/'0'/fastd_off/") $(echo "$U"|grep simple-tc.mesh_vpn.enabled|cut -d"=" -f2|sed -e "s/'1'/\*BW-LIMITED!\*/"|sed -e "s/'0'//") - imagename=\'$imagename\' $([ $(head -c 4 /tmp/sysinfo/model)  = 'TP-L' ] &&(. /lib/ar71xx.sh ;. /lib/functions.sh ; echo \ HWID=\'$(tplink_get_hwid)\')) - $(df|grep "overlayfs"|awk '{print "overlayfs="$4"kB free, "$5" used"}')
for r in 0 1 2; do echo "$U"|grep wireless.radio$r>/dev/null && (echo -n w$(echo "$U"|grep wireless.radio$r.disabled|cut -d"=" -f2)|sed -e "s/w'1'/Radio$r.OFF/"|sed -e "s/w'0'/Radio$r.ON/"|sed -e "s/w/Radio$r.ON/";echo \ r$r.ch=$(echo "$U"|grep radio$r.channel|cut -d"=" -f2) r$r.mode=$(echo "$U"|grep wireless.radio$r.htmode|cut -d"=" -f2) r$r.tx=\'$(iwinfo radio$r txpowerlist|grep "^*"|cut -d" " -f2)\' r$r.wifimesh-off=$(echo "$U"|grep wireless.mesh_radio$r.disabled|cut -d"=" -f2) r$r.ap-off=$(echo "$U"|grep wireless.client_radio$r.disabled|cut -d"=" -f2)); done
echo -n "MoW.off=$MoWoff MoL.off=$MoLoff "
[ "$MoLoff" == "'0'" ] && echo -n "MoL=$ifMoL "
echo WAN=$ifWAN LANCLI=$lanCLI CLI=$ifCLI
echo switch0: $(swconfig dev switch0 show | grep 'link:'|sed -e 's/link://g' -e 's/port:/p/g' -e 's/speed://g' -e 's/baseT//g' -e 's/ full-duplex/fdx/g' -e 's/ half-duplex/hdx/g' -e 's/flow/f/g' -e 's/\t//g' -e 's/$/;/g' -e 's/ ;/;/g')
echo "########################################### Contact:'$(echo "$U"|grep contact|cut -d= -f2)'"
([ "$VPNon" == "'1'" ] && [ "$MoWoff" == "'0'" ]) && echo ALARM! MoW-VPN-Konflikt?
# Mesh auf LAN an und ein LAN-Port zugleich in der Client-Bridge (verglich frueher mit dem nie gesetzten $ifLAN)
([ "$MoLoff" == "'0'" ] && [ "$lanCLI" != "''" ]) && echo ALARM! MoL-CLI-Konflikt?
([ "$VPNon" == "'1'" ] && [ ! $(echo "$batgw"|grep -i vpn) ]) && echo WARNING: VPN enabled, aber nicht verbunden?
# just some handy aliases
alias cd..="cd .."
alias myip="echo -n 'ifconfig' && ifconfig |head|tail -n1 && echo 'from ssh : ' $SSH_CONNECTION"
alias status="source /etc/profile"
alias ll="ls -la"
