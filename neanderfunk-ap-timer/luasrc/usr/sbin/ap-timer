#!/usr/bin/lua
local timestamp = os.time()
local uci = require('simple-uci').cursor()

-- uci booleans like OpenWrt's shell get_bool: 1/true/yes/on/enabled.
-- simple-uci's get_bool knows only "1"; this is our own key, typed by hand
-- as well.
local function uci_true(...)
	local v = uci:get(...)
	return v == '1' or v == 'true' or v == 'yes' or v == 'on' or v == 'enabled'
end

local function compare(list, value)
	if not list then
		return nil
	end

	for _, v in ipairs(list) do
		if v == value then
			return true
		end
	end

	return false
end

local function getDay()
	local type = uci:get('ap-timer', 'settings', 'type')
	if type == 'day' then return 'all'
	elseif type == 'week' then return os.date('%a', timestamp)
	elseif type == 'month' then return os.date('%d', timestamp)
	else return nil
	end
end

-- All APs of one kind, not a fixed client_radio0/1: Gluon 2025.1 supports
-- more than two radios (tri-band devices), and the numbering can have gaps.
-- kind: 'client' or 'owe' (Gluon's OWE BSS next to the client AP, hidden in
-- transition mode).
local function sections(kind)
	local out = {}
	uci:foreach('wireless', 'wifi-iface', function(s)
		if s['.name']:match('^' .. kind .. '_radio%d+$') then
			table.insert(out, s['.name'])
		end
	end)
	return out
end

-- Is the offline SSID of neanderfunk-ssid-changer on the client AP next to
-- this OWE BSS? Then the OWE BSS stays off when the timer switches on;
-- ssid-changer turns it back on once the node is online again.
local function offlineSsid(owe)
	local ssid = uci:get('wireless', (owe:gsub('^owe_', 'client_')), 'ssid')
	local prefix = uci:get('ssid-changer', 'settings', 'prefix') or 'FF_Offline_'
	return ssid ~= nil and ssid:sub(1, #prefix) == prefix
end

-- "wifi reconf" instead of a plain "wifi": under OpenWrt 24.10 that takes
-- every radio down and up again, mesh included, while reconf only reloads
-- what changed. Under the wifi lock shared with ssid-changer, hotfix and
-- linkcheck. This runs once in its minute, so a busy lock is waited for
-- (busybox flock has no -w); should it stay busy, the change is in the uci
-- delta already and the next wifi reconf by anyone applies it.
local function wifiReconf()
	for _ = 1, 10 do
		if os.execute("flock -n /var/lock/neanderfunk-wifi.lock -c 'wifi reconf'") == 0 then
			return
		end
		os.execute('sleep 5')
	end
	os.execute('logger -t ap-timer "wifi lock busy, change stays in the uci delta"')
end

local function apSet(enable)
	local changed = false
	for _, section in ipairs(sections('client')) do
		uci:set('wireless', section, 'disabled', not enable)
		changed = true
	end
	-- The OWE BSS goes with its client AP, otherwise clients would stay
	-- connected over OWE all through the off time. Switching on reverts the
	-- delta instead of writing disabled=0, so the OWE BSS is back to what the
	-- config says (Gluon creates it enabled) - unless the offline SSID is on.
	for _, section in ipairs(sections('owe')) do
		if not enable then
			uci:set('wireless', section, 'disabled', true)
		else
			uci:revert('wireless', section, 'disabled')
			if offlineSsid(section) then
				uci:set('wireless', section, 'disabled', true)
			end
		end
		changed = true
	end

	if changed then
		uci:save('wireless')
		wifiReconf()
	end
end

if uci_true('ap-timer', 'settings', 'enabled') then
	local day = getDay()
	local current = os.date('%H:%M', timestamp)

	local off = compare(uci:get_list('ap-timer', day, 'off'), current)
	local on = compare(uci:get_list('ap-timer', day, 'on'), current)

	if on and not off then
		apSet(true)
	end

	if off and not on then
		apSet(false)
	end
end
