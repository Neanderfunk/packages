# /etc/profile auf Gluon-Knoten mit neanderfunk-banner
#
# Zuerst das Profil von OpenWrt, unveraendert: PATH, ENV=/etc/shinit (Aliase
# wie ll auch in weiteren Shells), Failsafe, /etc/profile.d und der Hinweis
# bei vollem Overlay. Es zeigt auch /etc/banner an.
#
# Dahinter die Statusuebersicht (nodestatus), aber nur in einer interaktiven
# Shell und nicht im Failsafe: "ssh knoten befehl" und Skripte mit "sh -l"
# bekommen sie nicht.

if [ -f /etc/profile.openwrt ]; then
	. /etc/profile.openwrt
else
	export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
	export HOME=$(grep -e "^${USER:-root}:" /etc/passwd | cut -d ":" -f 6)
	export HOME=${HOME:-/root}
	export PS1='\u@\h:\w\$ '
	[ -f /etc/banner ] && cat /etc/banner
fi

alias cd..='cd ..'
alias myip='ip addr show br-client; echo "from ssh: $SSH_CONNECTION"'
alias status='nodestatus'

case "$-" in
	*i*)
		[ -z "$FAILSAFE" ] && [ -x /usr/bin/nodestatus ] && /usr/bin/nodestatus
		;;
esac
