#!/usr/bin/lua
-- channel [2.4-GHz-Kanal [5-GHz-Kanal]] [--no-keep] [-f] - WLAN-Kanaele zeigen
-- oder setzen.
--
--     channel               je Radio: Band, Kanal (live und uci), HT-Mode,
--                           ob der Kanal Updates uebersteht, Mesh-Nachbarn
--     channel 6             2.4 GHz auf Kanal 6
--     channel 6 44          2.4 GHz auf 6, 5 GHz auf 44
--     channel - 44          nur 5 GHz ("-" laesst ein Band, wie es ist)
--     channel auto auto     beide auf Autochannel
--     channel autofix       alle Baender per Scan auf einen Kanal ohne eigenes
--                           Mesh (siehe autofix weiter unten); -n zeigt nur
--     channel - autofix     nur 5 GHz, "channel autofix -" nur 2.4 GHz
--     channel mesh          umgekehrt: Mesh an und auf den Kanal mit dem
--                           staerksten eigenen Mesh (siehe mesh weiter unten)
--
-- Der erste Wert gilt immer fuer 2.4 GHz, der zweite fuer 5 GHz - egal welches
-- Radio (radio0/radio1) welches Band hat; die Zuordnung kommt aus
-- wireless.<radio>.band. Die Breite (HT-Mode) bleibt, wie sie ist.
--
-- Behalten: Gluon setzt bei jedem Update Kanal, Kanalliste und Breite auf die
-- Werte der Site zurueck. Ausser mit --no-keep setzt channel deshalb fuer jedes
-- geaenderte Band gluon.wireless.preserve_channels_<band>=1; die wertet
-- neanderfunk-preserve-wifichannel aus (zusaetzlich zu Gluons globalem
-- preserve_channels). Steht der globale Schalter noch auf 1, wird er dabei in
-- die Band-Schluessel ueberfuehrt: jedes Band bekommt seinen Schluessel auf 1,
-- der globale geht auf 0 - fuer den Knoten aendert sich dadurch nichts, aber
-- von da an laesst sich je Band entscheiden. Wer ihn spaeter wieder auf 1
-- setzt, haelt wie bisher alle Baender fest.
--
-- Schutz vor dem Aussperren: Laeuft der Weg zum gewaehlten Gateway (batctl gwl)
-- ueber das Mesh-Interface eines Radios, aendert channel dessen Kanal nur mit
-- -f - immer, auch bei autofix und mesh. Haengen am Mesh-Interface Nachbarn,
-- reisst ein Kanalwechsel diese Links ab - ueber genau diese Links kann auch
-- die eigene SSH-Sitzung laufen, und der neue Kanal ist dauerhaft gespeichert.
-- Dann aendert channel das Radio nur mit -f. Ebenso "auto" auf einem Radio mit
-- Mesh: auf auto kommt das Mesh nicht hoch (kein fester Kanal zum Treffen).
-- Im Outdoor-Modus waehlt Gluon den 5-GHz-Kanal selbst aus der Kanalliste der
-- Site; dort setzt channel nichts.
--
-- Gespeichert wird, ein Eingriff ins Flash wie bei routername. Aber nicht per
-- "uci commit wireless": im uci-Delta stehen Laufzeit-Aenderungen, die nie ins
-- Flash sollen (Offline-SSID des ssid-changers, ap-timer). libuci liest das
-- Delta aus /tmp/.uci bei jedem Cursor mit, auch mit eigenem savedir. Deshalb
-- wird eine Kopie der Konfiguration unter anderem Namen geaendert (fuer die gibt
-- es kein Delta) und zurueckkopiert; das Delta bleibt und gilt weiter obenauf.
-- Danach startet es nur die geaenderten Radios neu (wifi up <radio>).

local uci = require('simple-uci').cursor()
local rawuci = require('uci')

local BANDS = { '2g', '5g' }
local LABEL = { ['2g'] = '2.4 GHz', ['5g'] = '5 GHz' }
local TMPDIR = '/tmp/nf-channel'

local function sh(cmd)
	local p = io.popen(cmd .. ' 2>/dev/null')
	if not p then return '' end
	local s = p:read('*a') or ''
	p:close()
	return s
end

local function die(msg)
	io.stderr:write('channel: ' .. msg .. '\n')
	os.exit(1)
end

local function usage()
	io.stderr:write([==[
Aufruf: channel [2.4-GHz-Kanal [5-GHz-Kanal]] [-n] [--no-keep] [-f]
  ohne Kanal: anzeigen
  Kanal: Zahl, "auto" oder "-" (Band nicht aendern)
  Kanal "autofix" (auch "fixauto"): per Scan einen Kanal ohne das eigene Mesh waehlen;
             "channel autofix" allein: alle Baender, "channel - autofix": nur 5 GHz
  Kanal "mesh": Mesh einschalten und den Kanal mit dem staerksten eigenen Mesh
             waehlen ("channel mesh", "channel mesh -", "channel - mesh")
  -n         nur zeigen, was passieren wuerde (mit autofix: die Auswertung)
  --no-keep  Kanal nicht ueber Updates behalten (kein preserve_channels_<band>)
  -f         auch wenn Mesh-Nachbarn an diesem Radio haengen
]==])
	os.exit(1)
end

local function readline(path)
	local f = io.open(path)
	if not f then return nil end
	local l = f:read('*l')
	f:close()
	return l
end

local function operup(name)
	return name and readline('/sys/class/net/' .. name .. '/operstate') == 'up'
end

-- Radios nach Band; je Radio die Interfaces nach Rolle. Hat ein Band mehrere
-- Radios (Tri-Band mit zwei 5-GHz-Radios, ab Gluon 2025.1 moeglich), fasst
-- channel vorerst nur das erste an und sagt das; die richtige Wahl (Mesh- bzw.
-- Client-Radio) kommt mit dem ersten solchen Geraet im Netz.
local radios, extra_radios = {}, {}
uci:foreach('wireless', 'wifi-device', function(s)
	if s.band and not radios[s.band] then
		radios[s.band] = { name = s['.name'], band = s.band, channel = s.channel, htmode = s.htmode,
			disabled = s.disabled == '1' }
	elseif s.band then
		-- Tri-Band (zwei 5-GHz-Radios): vorerst nur das erste, siehe Kopf
		extra_radios[s.band] = (extra_radios[s.band] and (extra_radios[s.band] .. ' ') or '') .. s['.name']
	end
end)
uci:foreach('wireless', 'wifi-iface', function(s)
	for _, r in pairs(radios) do
		if s.device == r.name then
			r.ifaces = r.ifaces or {}
			table.insert(r.ifaces, s.ifname)
			if s.mode == 'mesh' then
				r.mesh = s.ifname
				r.mesh_section = s['.name']
				r.mesh_id = s.mesh_id
				r.mesh_enabled = s.disabled ~= '1'
			end
		end
	end
end)

-- Mesh-Nachbarn je Interface (batctl n: Interface in der ersten Spalte)
local neighbours = {}
for line in sh('batctl n -H'):gmatch('[^\n]+') do
	local ifname = line:match('^%s*(%S+)%s+%x%x:')
	if ifname then neighbours[ifname] = (neighbours[ifname] or 0) + 1 end
end

-- Weg zum gewaehlten Gateway (batctl gwl: "* <gw> (<tq>) <nexthop> [ <if>]: ...")
local gw = {}
for line in sh('batctl gwl -H'):gmatch('[^\n]+') do
	local g, tq, hop, ifname = line:match('^%s*%*%s+(%S+)%s+%(%s*(%d+)%)%s+(%S+)%s+%[%s*([^%]%s]+)%s*%]')
	if g then gw = { mac = g, tq = tq, hop = hop, ifname = ifname } end
end

local function live(r)
	for _, ifname in ipairs(r.ifaces or {}) do
		if operup(ifname) then
			local info = sh('iwinfo ' .. ifname .. ' info')
			return info:match('Channel: (%d+)'), info:match('HT Mode: (%S+)')
		end
	end
end

local function keep_state(band)
	if uci:get_bool('gluon', 'wireless', 'preserve_channels') then
		return 'fest (global)'
	elseif uci:get_bool('gluon', 'wireless', 'preserve_channels_' .. band) then
		return 'fest'
	end
	return 'Update setzt auf Site zurueck'
end

local outdoor = uci:get_bool('gluon', 'wireless', 'outdoor')

local function show()
	local any = false
	for _, band in ipairs(BANDS) do
		local r = radios[band]
		if r then
			any = true
			local ch, mode = live(r)
			local chtxt = ch or '-'
			if r.channel and r.channel ~= ch then
				chtxt = chtxt .. ' (uci ' .. r.channel .. ')'
			end
			local extra = {}
			if r.disabled then table.insert(extra, 'Radio aus') end
			if band == '5g' and outdoor then table.insert(extra, 'Outdoor') end
			if r.mesh then
				if r.mesh_enabled and r.channel ~= 'auto' then
					table.insert(extra, 'Mesh ' .. (neighbours[r.mesh] or 0) .. ' Nachbarn')
				else
					table.insert(extra, 'kein Mesh')
				end
			end
			print(string.format('%-8s %-7s Kanal %-14s %-7s %s%s', LABEL[band], r.name, chtxt,
				r.htmode or mode or '?', keep_state(band),
				#extra > 0 and ('  ' .. table.concat(extra, ', ')) or ''))
		end
	end
	if not any then
		print('kein WLAN-Radio')
	end
	for band, names in pairs(extra_radios) do
		print(string.format('Hinweis: weitere %s-Radios (%s) zeigt und aendert channel noch nicht', LABEL[band] or band, names))
	end
end

-- --- Argumente ---------------------------------------------------------------

local values, keep, force, dry = {}, true, false, false
for _, a in ipairs(arg) do
	-- tolerant: AUTO, Autofix, und "fixauto" fuer alle, die es andersherum tippen
	a = a:lower()
	if a == 'fixauto' then a = 'autofix' end
	if a == '--no-keep' then keep = false
	elseif a == '-f' or a == '--force' then force = true
	elseif a == '-n' or a == '--dry-run' then dry = true
	elseif a == '-h' or a == '--help' then usage()
	elseif a == '-' or a == 'auto' or a == 'autofix' or a == 'mesh' or a:match('^%d+$') then table.insert(values, a)
	else
		io.stderr:write('channel: unbekanntes Argument "' .. a .. '"\n')
		usage()
	end
end
if #values > #BANDS then usage() end
-- "channel autofix" allein gilt fuer alle Baender (adorfer); nur ein Band mit
-- "-" an der anderen Stelle: "channel autofix -" bzw. "channel - autofix".
-- Eine einzelne Zahl oder "auto" gilt weiter nur fuer 2.4 GHz.
if #values == 1 and (values[1] == 'autofix' or values[1] == 'mesh') then
	for i = 2, #BANDS do values[i] = values[1] end
end

if #values == 0 then
	show()
	os.exit(0)
end

-- --- autofix -------------------------------------------------------------------
--
-- Waehlt per Scan einen Kanal, auf dem das eigene Mesh NICHT zu hoeren ist -
-- fuer Knoten, die nicht ins WLAN-Mesh der Nachbarn sollen (Uplink per Kabel
-- oder VPN). Reihenfolge (adorfer, 27.09.2026):
--   1. Kandidaten: 2.4 GHz die ungeraden 1-11 (ohne 13), 5 GHz die geraden
--      ausserhalb von DFS, also 36-48.
--   2. Kein eigenes Mesh (Mesh Point mit der eigenen mesh_id). Sind mehrere
--      frei, moeglichst auch kein weiteres Freifunk: SSID mit "freifunk", die
--      eigene Client-SSID, die Offline-SSID, fremde Meshes (Mesh Point mit
--      anderer ID, Ad-Hoc). Danach weniger fremde Netze.
--   3. Notfalls auf 2.4 GHz die geraden 2-10, auf 5 GHz die DFS-Kanaele 52-144,
--      gleiche Regeln. Auf DFS kommt das 5-GHz-Mesh nicht hoch; das sagt
--      autofix dann dazu (adorfer, 27.09.2026).
--   4. Ueberall eigenes Mesh: der Kanal, dessen staerkstes eigenes Mesh am
--      schwaechsten ist (lieber -88 dBm als -60 dBm).
--   5. Liefert der Scan nichts (manche Treiber scannen nicht, solange das
--      Radio sendet): zufaellig unter den Kandidaten aus 1.
-- Erfuellt der aktuelle Kanal die Kriterien genauso gut, bleibt er, damit nichts
-- grundlos wechselt; weniger fremde Netze zaehlen erst danach.
-- Gezaehlt wird nur der Primaerkanal einer Zelle, wie ihn der Scan meldet.

-- DFS nach Frequenz: 5250 bis 5725 MHz, Kanaele 52 bis 144 (ETSI). iwinfo
-- liefert kein DFS-Kennzeichen.
function is_dfs(ch)
	ch = tonumber(ch)
	return ch ~= nil and ch >= 52 and ch <= 144
end

local allowed_cache = {}
function allowed_channels(r)
	if not allowed_cache[r.name] then
		local list = {}
		local phy = sh('iwinfo nl80211 phyname ' .. r.name):match('%S+')
		-- Nach Frequenz aufs Band des Radios filtern: ab OpenWrt 24.10 kann ein
		-- phy mehrere Baender tragen (Wi-Fi 7), dann stuenden in der freqlist
		-- Kanaele aller Baender - und 6-GHz-Kanalnummern ueberschneiden sich
		-- mit denen von 2.4 und 5 GHz.
		local lo, hi = 0, 99999
		if r.band == '2g' then lo, hi = 2400, 2500
		elseif r.band == '5g' then lo, hi = 5150, 5925
		elseif r.band == '6g' then lo, hi = 5925, 7125 end
		for _, f in ipairs(phy and require('iwinfo').nl80211.freqlist(phy) or {}) do
			local mhz = tonumber(f.mhz) or 0
			if not f.restricted and (mhz == 0 or (mhz >= lo and mhz < hi)) then
				table.insert(list, f.channel)
			end
		end
		allowed_cache[r.name] = list
	end
	return allowed_cache[r.name]
end

local function mesh_id(r)
	local id
	uci:foreach('wireless', 'wifi-iface', function(s)
		if s.device == r.name and s.mode == 'mesh' and s.mesh_id then id = s.mesh_id end
	end)
	return id
end

local function ff_names(r)
	local names = {}
	uci:foreach('wireless', 'wifi-iface', function(s)
		if s.device == r.name and s.ssid then names[s.ssid] = true end
	end)
	return names, uci:get('ssid-changer', 'settings', 'prefix') or 'FF_Offline_'
end

function autofix(band, r)
	local own = mesh_id(r)
	local names, offline_prefix = ff_names(r)
	print(string.format('channel: %s: Scan auf %s ...', LABEL[band], r.name))
	io.stdout:flush()
	-- Manche Treiber scannen nicht (oder nicht, solange das Radio sendet).
	-- Ohne Scan: zufaellig unter den ersten Kandidaten (adorfer).
	local cells = require('iwinfo').nl80211.scanlist(r.name) or {}

	local stat = {}
	local function st(ch)
		stat[ch] = stat[ch] or { own = 0, own_max = nil, ff = 0, other = 0 }
		return stat[ch]
	end
	for _, c in ipairs(cells) do
		local ch, ssid, mode = tonumber(c.channel), c.ssid or '', c.mode or ''
		if ch then
			local t = st(ch)
			local is_mesh = mode == 'Mesh Point' or mode == 'Ad-Hoc'
			if mode == 'Mesh Point' and own and ssid == own then
				t.own = t.own + 1
				if not t.own_max or (c.signal or -100) > t.own_max then t.own_max = c.signal or -100 end
			elseif is_mesh or names[ssid] or ssid:lower():find('freifunk', 1, true)
					or ssid:sub(1, #offline_prefix) == offline_prefix then
				t.ff = t.ff + 1
			else
				t.other = t.other + 1
			end
		end
	end

	local allowed = {}
	for _, ch in ipairs(allowed_channels(r)) do allowed[ch] = true end
	local primary, fallback = {}, {}
	if band == '2g' then
		for _, ch in ipairs({ 1, 3, 5, 7, 9, 11 }) do if allowed[ch] then table.insert(primary, ch) end end
		for _, ch in ipairs({ 2, 4, 6, 8, 10 }) do if allowed[ch] then table.insert(fallback, ch) end end
	else
		-- 5 GHz: erst 36 bis 48, DFS (52 bis 144) nur als Ausweg. Auf DFS kommt
		-- das 5-GHz-Mesh nicht hoch (Schulstrasse 7, 7 von 7, MT7981 wie
		-- ath10k): der Knoten waere auf 5 GHz kein Rettungsanker mehr.
		for _, ch in ipairs(allowed_channels(r)) do
			if ch % 2 == 0 then
				table.insert(is_dfs(ch) and fallback or primary, ch)
			end
		end
	end
	local current = tonumber(r.channel)

	if #cells == 0 then
		if #primary == 0 then
			die(LABEL[band] .. ': kein Kandidat (freqlist leer?)')
		end
		local f = io.open('/dev/urandom', 'rb')
		local seed = f and f:read(4) or tostring(os.time())
		if f then f:close() end
		local n = 0
		for i = 1, #seed do n = n * 256 + seed:byte(i) end
		math.randomseed(n % 2147483647)
		local choice = primary[math.random(#primary)]
		print(string.format('channel: %s: Scan ohne Ergebnis, autofix waehlt zufaellig Kanal %d (aus %s)',
			LABEL[band], choice, table.concat(primary, ' ')))
		return tostring(choice)
	end

	-- bessere Wahl zuerst: ohne Freifunk, weniger Freifunk, dann der aktuelle
	-- Kanal (erfuellt er beide Kriterien, wird nicht gewechselt), dann weniger
	-- fremde Netze
	local function better_free(a, b)
		local sa, sb = st(a), st(b)
		if (sa.ff > 0) ~= (sb.ff > 0) then return sa.ff == 0 end
		if sa.ff ~= sb.ff then return sa.ff < sb.ff end
		if (a == current) ~= (b == current) then return a == current end
		if sa.other ~= sb.other then return sa.other < sb.other end
		return a < b
	end
	local function pick_free(list)
		local free = {}
		for _, ch in ipairs(list) do if st(ch).own == 0 then table.insert(free, ch) end end
		table.sort(free, better_free)
		return free[1]
	end

	local choice, why = pick_free(primary), nil
	if choice then
		why = 'kein eigenes Mesh'
	elseif #fallback > 0 then
		choice = pick_free(fallback)
		why = choice and (band == '2g' and 'kein eigenes Mesh (Ausweichkanal gerade)'
			or 'kein eigenes Mesh, aber nur auf DFS frei')
	end
	if not choice then
		local all = {}
		for _, ch in ipairs(primary) do table.insert(all, ch) end
		for _, ch in ipairs(fallback) do table.insert(all, ch) end
		table.sort(all, function(a, b)
			local sa, sb = st(a), st(b)
			if sa.own_max ~= sb.own_max then return (sa.own_max or -200) < (sb.own_max or -200) end
			return better_free(a, b)
		end)
		choice = all[1]
		why = choice and ('ueberall eigenes Mesh, hier am schwaechsten (' .. tostring(st(choice).own_max) .. ' dBm)')
	end
	if not choice then
		die(LABEL[band] .. ': kein Kandidat (freqlist leer?)')
	end
	if band == '5g' and is_dfs(choice) then
		why = why .. ' - ACHTUNG: auf DFS kein 5-GHz-Mesh, der Knoten ist auf 5 GHz kein Rettungsanker mehr'
	end
	if choice and st(choice).ff > 0 and why == 'kein eigenes Mesh' then
		why = why .. ', aber ' .. st(choice).ff .. 'x Freifunk'
	elseif why == 'kein eigenes Mesh' then
		why = why .. ', kein Freifunk'
	end

	-- Auswertung zeigen
	local shown = {}
	for _, ch in ipairs(primary) do table.insert(shown, ch) end
	for _, ch in ipairs(fallback) do table.insert(shown, ch) end
	print(string.format('  %d Zellen, eigenes Mesh "%s"', #cells, tostring(own)))
	print('  Kanal  eigenes Mesh (staerkstes)  Freifunk  andere')
	for _, ch in ipairs(shown) do
		local t = st(ch)
		print(string.format('  %-5s  %-25s  %-8d  %d%s', ch,
			t.own > 0 and (t.own .. 'x (' .. t.own_max .. ' dBm)') or '-', t.ff, t.other,
			(ch == choice and '   <- gewaehlt' or '') .. (ch == current and '   (aktuell)' or '')))
	end
	print(string.format('channel: %s: autofix waehlt Kanal %d - %s', LABEL[band], choice, why))
	return tostring(choice)
end

-- --- mesh ----------------------------------------------------------------------
--
-- Das Gegenstueck zu autofix: der Knoten sucht sich den Kanal, auf dem er sein
-- eigenes Mesh am besten hoert. Fuer den Fall, dass man mit Laptop oder Tablet
-- an einem Knoten steht, der offline ist oder nur noch knapp per Mesh versorgt
-- wird ("such dir den besten Meshpartner"). Je Band:
--   1. Ist das Mesh auf diesem Radio abgeschaltet, wird es eingeschaltet.
--   2. Scan; gesucht sind Mesh Points mit der mesh_id DIESES Radios (sie kann
--      je Band verschieden sein). Gewaehlt wird der Kanal mit dem staerksten.
--      Hoert der Knoten keins, bleibt der Kanal.
-- Die Mesh-Sperre (-f) entfaellt, wenn der neue Kanal ein staerkeres eigenes
-- Mesh hat als der aktuelle: dann ist der Wechsel eine Verbesserung. Der AP
-- desselben Radios wandert mit - ein Laptop an diesem Band verbindet neu.

function meshfind(band, r)
	if not r.mesh then
		print(string.format('channel: %s: %s hat kein Mesh-Interface - nicht geaendert', LABEL[band], r.name))
		return nil
	end
	local own = r.mesh_id
	print(string.format('channel: %s: Scan auf %s nach Mesh "%s" ...', LABEL[band], r.name, tostring(own)))
	io.stdout:flush()
	local cells = require('iwinfo').nl80211.scanlist(r.name) or {}
	local best, count = {}, {}
	for _, c in ipairs(cells) do
		local ch = tonumber(c.channel)
		if ch and c.mode == 'Mesh Point' and own and c.ssid == own then
			count[ch] = (count[ch] or 0) + 1
			if not best[ch] or (c.signal or -100) > best[ch] then best[ch] = c.signal or -100 end
		end
	end
	local chans = {}
	for ch in pairs(best) do table.insert(chans, ch) end
	table.sort(chans, function(a, b) return best[a] > best[b] end)
	local current = tonumber(r.channel)
	if #cells == 0 then
		print(string.format('channel: %s: Scan ohne Ergebnis - Kanal bleibt %s', LABEL[band], tostring(r.channel)))
		return r.channel, false
	end
	if #chans == 0 then
		print(string.format('channel: %s: %d Zellen, aber kein Mesh "%s" zu hoeren - Kanal bleibt %s',
			LABEL[band], #cells, tostring(own), tostring(r.channel)))
		return r.channel, false
	end
	print('  Kanal  eigenes Mesh  staerkstes')
	for _, ch in ipairs(chans) do
		print(string.format('  %-5d  %-12d  %d dBm%s%s', ch, count[ch], best[ch],
			ch == chans[1] and '   <- gewaehlt' or '', ch == current and '   (aktuell)' or ''))
	end
	local choice = chans[1]
	-- Gleich stark wie auf dem aktuellen Kanal: bleiben
	if current and best[current] and best[current] >= best[choice] then
		choice = current
	end
	local improve = choice ~= current and (not current or not best[current] or best[choice] > best[current])
	print(string.format('channel: %s: mesh waehlt Kanal %d (%d dBm)', LABEL[band], choice, best[choice]))
	return tostring(choice), improve
end

-- --- Pruefen: erst alles, dann schreiben ---------------------------------------

local changes = {}
local refused = false
for i, v in ipairs(values) do
	local band = BANDS[i]
	local r = radios[band]
	if v == '-' then
		-- Band bleibt
	elseif not r then
		die('kein ' .. LABEL[band] .. '-Radio auf diesem Geraet (mit "-" auslassen)')
	elseif band == '5g' and outdoor then
		print('channel: ' .. LABEL[band] .. ' ist im Outdoor-Modus, Gluon waehlt den Kanal aus der Kanalliste'
			.. (v == 'mesh' and ' und schaltet das 5-GHz-Mesh ab' or '') .. ' - nicht geaendert')
	elseif v == 'mesh' and not r.mesh then
		print(string.format('channel: %s: %s hat kein Mesh-Interface - nicht geaendert', LABEL[band], r.name))
	else
		local improve, enable_mesh = false, nil
		if v == 'autofix' then
			v = autofix(band, r)
		elseif v == 'mesh' then
			if not r.mesh_enabled then
				enable_mesh = r.mesh_section
				print(string.format('channel: %s: Mesh (%s) ist aus - wird eingeschaltet', LABEL[band], r.mesh_section))
			end
			v, improve = meshfind(band, r)
		end
		local ok = v == 'auto'
		if not ok then
			local n = tonumber(v)
			for _, ch in ipairs(allowed_channels(r)) do
				if ch == n then ok = true end
			end
			if not ok then
				die(LABEL[band] .. ': Kanal ' .. v .. ' kann ' .. r.name .. ' hier nicht (iwinfo freqlist)')
			end
		end
		local nb = r.mesh and r.mesh_enabled and neighbours[r.mesh] or 0
		if v ~= r.channel and gw.ifname and gw.ifname == r.mesh and not force then
			-- Der Gateway-Weg laeuft ueber genau dieses Radio: immer nur mit -f,
			-- auch wenn mesh anderswo ein staerkeres Mesh hoert
			print(string.format('channel: %s: ACHTUNG, der Knoten verliert damit vermutlich seinen besten Weg'
				.. ' zum Gateway (%s, TQ %s, ueber %s an %s). Wenn wirklich gewollt: noch einmal mit -f',
				LABEL[band], gw.mac, gw.tq, gw.hop, r.mesh))
			refused = true
		elseif v ~= r.channel and nb > 0 and not force and not improve then
			print(string.format('channel: %s: %d Mesh-Nachbarn an %s verlieren mit dem Wechsel den Link%s - nur mit -f',
				LABEL[band], nb, r.mesh, v == 'auto' and ' (auf auto kommt das Mesh nicht hoch)' or ''))
			refused = true
		else
			if v ~= r.channel and nb > 0 and improve then
				print(string.format('channel: %s: %d bisherige Mesh-Nachbarn an %s gehen, das Mesh auf Kanal %s ist staerker',
					LABEL[band], nb, r.mesh, v))
			end
			if v ~= r.channel and #(r.ifaces or {}) > 1 then
				print(string.format('channel: %s: der AP wandert mit - Geraete an diesem Band verbinden neu', LABEL[band]))
			end
			table.insert(changes, { band = band, radio = r.name, from = r.channel, to = v, enable_mesh = enable_mesh })
		end
	end
end
if refused then
	os.exit(1)
end
if dry then
	for _, ch in ipairs(changes) do
		print(string.format('channel: -n: %s (%s) %s -> %s%s, nichts geschrieben', LABEL[ch.band], ch.radio,
			tostring(ch.from), ch.to, ch.enable_mesh and (', ' .. ch.enable_mesh .. ' an') or ''))
	end
	os.exit(0)
end

-- --- Schreiben -----------------------------------------------------------------

-- set_committed(config, { {section, option, value}, ... }): aendert nur diese
-- Optionen in /etc/config/<config>, ohne das uci-Delta mitzuschreiben (Kopf).
local function set_committed(config, sets)
	local copy = config .. 'nfchannel'
	os.execute('mkdir -p ' .. TMPDIR)
	assert(os.execute(string.format('cp /etc/config/%s %s/%s', config, TMPDIR, copy)) == 0,
		'kann /etc/config/' .. config .. ' nicht kopieren')
	local c = rawuci.cursor(TMPDIR, TMPDIR .. '/save')
	for _, s in ipairs(sets) do
		c:set(copy, s[1], s[2], s[3])
		-- ein Delta genau fuer diese Option (etwa von Hand gesetzt, nie
		-- committet) gaelte sonst weiter obenauf
		os.execute(string.format('uci -q revert %s.%s.%s', config, s[1], s[2]))
	end
	c:commit(copy)
	assert(os.execute(string.format('cp %s/%s /etc/config/.%s.nfchannel && mv /etc/config/.%s.nfchannel /etc/config/%s',
		TMPDIR, copy, config, config, config)) == 0, 'kann /etc/config/' .. config .. ' nicht schreiben')
	os.execute('rm -rf ' .. TMPDIR)
end

local wireless_sets, gluon_sets, notes, restart = {}, {}, {}, {}
for _, ch in ipairs(changes) do
	if ch.to ~= ch.from then
		table.insert(wireless_sets, { ch.radio, 'channel', ch.to })
		restart[ch.radio] = true
	end
	if ch.enable_mesh then
		table.insert(wireless_sets, { ch.enable_mesh, 'disabled', '0' })
		restart[ch.radio] = true
	end
end

if keep and #changes > 0 then
	if uci:get_bool('gluon', 'wireless', 'preserve_channels') then
		-- Ueberfuehren: alle Baender, die es gibt, behalten wie bisher
		for _, band in ipairs(BANDS) do
			if radios[band] then
				table.insert(gluon_sets, { 'wireless', 'preserve_channels_' .. band, '1' })
			end
		end
		table.insert(gluon_sets, { 'wireless', 'preserve_channels', '0' })
		table.insert(notes, 'globales preserve_channels in die Band-Schluessel ueberfuehrt')
	else
		for _, ch in ipairs(changes) do
			if not uci:get_bool('gluon', 'wireless', 'preserve_channels_' .. ch.band) then
				table.insert(gluon_sets, { 'wireless', 'preserve_channels_' .. ch.band, '1' })
			end
		end
	end
end

if #wireless_sets == 0 and #gluon_sets == 0 then
	print('channel: nichts zu aendern')
	show()
	os.exit(0)
end

if #wireless_sets > 0 then set_committed('wireless', wireless_sets) end
if #gluon_sets > 0 then set_committed('gluon', gluon_sets) end

for _, ch in ipairs(changes) do
	if ch.to ~= ch.from then
		print(string.format('channel: %s (%s): %s -> %s', LABEL[ch.band], ch.radio, tostring(ch.from), ch.to))
	end
	if ch.enable_mesh then
		print(string.format('channel: %s: %s eingeschaltet', LABEL[ch.band], ch.enable_mesh))
	end
end
for _, s in ipairs(gluon_sets) do
	print(string.format('channel: gluon.wireless.%s=%s', s[2], s[3]))
end
for _, n in ipairs(notes) do
	print('channel: ' .. n)
end
if not keep then
	print('channel: --no-keep: das naechste Update setzt '
		.. (uci:get_bool('gluon', 'wireless', 'preserve_channels') and 'trotzdem nichts zurueck (globales preserve_channels steht)'
			or 'auf die Kanaele der Site zurueck, soweit kein preserve_channels_<band> steht'))
end
os.execute('logger -t channel -- "' .. table.concat((function()
	local t = {}
	for _, s in ipairs(wireless_sets) do table.insert(t, s[1] .. '.' .. s[2] .. '=' .. s[3]) end
	for _, s in ipairs(gluon_sets) do table.insert(t, 'gluon.wireless.' .. s[2] .. '=' .. s[3]) end
	return t
end)(), ' ') .. '"')

-- Nur das geaenderte Radio neu starten, und zwar mit "wifi up <radio>", nicht
-- "wifi reload": nach reload mit neuem Kanal zieht das Mesh mit, der AP aber
-- verliert seine hostapd-BSS und sendet nicht mehr (COVR X1860/MT7915,
-- 4 von 4 Versuchen; mi4a/mt76x2 auf 5 GHz 2 von 2, 27.09.2026). "wifi up"
-- baut das Radio neu auf. Unter demselben Lock wie ssid-changer, hotfix,
-- linkcheck und wifi-blackout, damit kein Neustart in einen anderen faellt;
-- hier wartend (busybox-flock kennt kein -w), die anderen halten ihn kurz.
if next(restart) then
	for _, band in ipairs(BANDS) do
		local r = radios[band]
		if r and restart[r.name] then
			print('channel: wifi up ' .. r.name .. ' ...')
			io.stdout:flush()
			os.execute("flock /var/lock/neanderfunk-wifi.lock -c 'wifi up " .. r.name .. "'")
		end
	end
	os.execute('sleep 10')
end
-- Anzeige mit frisch gelesenem Stand
io.stdout:flush()
os.execute(arg[0])
