#!/bin/sh
# flash <url|verzeichnis-url|datei> [sysupgrade-optionen] - Firmware laden und
# flashen.
#
#     flash https://imageslive.ffdus.de/.../gluon-...-sysupgrade.bin
#     flash https://imageslive.ffdus.de/.../21_dias/sysupgrade/      # sucht selbst
#     flash http://.../gluon-...-sysupgrade.bin -n     # ohne Konfiguration
#     flash /tmp/image.bin                             # schon geladen
#
# Entspricht "cd /tmp && wget <url> && sysupgrade <optionen> <datei>", mit
# Pruefungen dazwischen:
#   - https:// wird zu http://: Die URL kommt meist aus der Zwischenablage,
#     und nicht jeder Knoten kann TLS (tiny-Geraete haben kein gluon-tls).
#   - Eine URL ohne Dateinamen (endet auf / oder der letzte Teil hat keinen
#     Punkt) gilt als Verzeichnis. Dann sucht flash das Image fuer dieses
#     Geraet selbst: zuerst im Autoupdater-Manifest (<branch>.manifest, die
#     eingestellte Branch zuerst), das auch die sha256 liefert, gegen die der
#     Download geprueft wird; sonst in der Verzeichnisliste nach
#     "-<imagename>-sysupgrade.". Den Image-Namen kennt Gluon
#     (platform_info, derselbe wie im Manifest).
#   - Nach dem Laden stehen Groesse, freier RAM und sha256 da - /tmp liegt im
#     RAM.
#   - "sysupgrade -T" prueft vorher, ob das Image zu diesem Geraet passt.
#     Passt es nicht, wird nichts geflasht.
#   - Bei wenig RAM (MemAvailable unter 32 MB vor dem Download oder unter
#     16 MB danach) geht flash vor wie der Autoupdater: vorher die Dienste
#     aus /usr/lib/autoupdater/download.d anhalten (respondd, uhttpd, cron,
#     micrond ...), zuletzt upgrade.d (wifi down, Netz aus, bat0 weg) und dann
#     sysupgrade. Sonst verhungert stage2 auf 64-MB-Geraeten: WLAN-Treiber
#     wie ath10k halten ihre RX-Puffer, bis der Watchdog resettet (Archer C25,
#     12.09.2026 - nichts geflasht). upgrade.d und sysupgrade laufen dann
#     losgeloest von der Sitzung, denn "wifi down"/"Netz aus" kappt SSH ueber
#     WLAN oder Mesh. Log in /tmp/flash.log und im Syslog (Tag flash); bricht
#     sysupgrade ab, stellt abort.d Netz und Dienste wieder her.
#     FLASH_HOOKS=1 erzwingt diesen Weg, FLASH_HOOKS=0 schaltet ihn ab.
# Optionen nach der URL gehen unveraendert an sysupgrade, und zwar VOR die
# Datei, wie sysupgrade es erwartet (z.B. -n, -F, -v).

HOOKDIR=/usr/lib/autoupdater
LOWMEM_KB=32768		# MemAvailable vor dem Download
LOWMEM_AFTER_KB=16384	# MemAvailable mit dem Image in /tmp
LOG=/tmp/flash.log

usage() {
	echo "Aufruf: flash <url|verzeichnis-url|datei> [sysupgrade-optionen]" >&2
	echo "  z.B.  flash http://server/pfad/sysupgrade/ -n" >&2
	exit 1
}

# run_hooks <download|upgrade|abort>: die Skripte des Autoupdaters
run_hooks() {
	local s
	for s in "$HOOKDIR/$1.d"/*; do
		[ -f "$s" ] && [ -x "$s" ] || continue
		"$s"
	done
}

mem_avail() {
	awk '/^MemAvailable:/ {print $2}' /proc/meminfo
}

say() {
	echo "flash: $*"
	logger -t flash "$*"
}

# Zweiter Teil, losgeloest von der Sitzung (siehe unten): upgrade.d und
# sysupgrade. Kommt sysupgrade zurueck, hat es nicht geflasht.
if [ "$1" = --detached ]; then
	shift
	file="$1"
	shift
	trap '' HUP PIPE
	exec >> "$LOG" 2>&1 < /dev/null
	say "upgrade.d (wifi down, Netz aus), dann sysupgrade $* $file"
	run_hooks upgrade
	say "RAM verfuegbar $(mem_avail) KiB"
	sysupgrade "$@" "$file"
	say "sysupgrade kam zurueck ($?), nichts geflasht - abort.d: Netz und Dienste wieder an"
	run_hooks abort
	exit 1
fi

# Wenig RAM: die Dienste anhalten wie der Autoupdater vor dem Download.
# Danach muss jeder Abbruch abort.d laufen lassen (fail).
stopped=''
stop_services() {
	[ -n "$stopped" ] && return
	if [ "${FLASH_HOOKS:-auto}" = 1 ]; then
		say "FLASH_HOOKS=1: halte Dienste an wie der Autoupdater (download.d)"
	else
		say "wenig RAM ($(mem_avail) KiB verfuegbar): halte Dienste an wie der Autoupdater (download.d)"
	fi
	run_hooks download
	stopped=1
}

fail() {
	echo "flash: $*" >&2
	if [ -n "$stopped" ]; then
		echo "flash: starte die angehaltenen Dienste wieder (abort.d)" >&2
		run_hooks abort
	fi
	exit 1
}

# find_image <verzeichnis-url>: setzt src (Datei-URL) und want_sha (leer, wenn
# nur aus der Verzeichnisliste gefunden)
find_image() {
	local dir="$1" img br tried=' ' mf=/tmp/flash.manifest line name
	img="$(lua -e 'print(require("platform_info").get_image_name())' 2>/dev/null)"
	if [ -z "$img" ] ; then
		echo "flash: kann den Image-Namen dieses Geraets nicht bestimmen." >&2
		return 1
	fi
	echo "flash: suche das Image fuer $img in $dir/"

	for br in $(uci -q get autoupdater.settings.branch) \
			$(uci -q show autoupdater | sed -n "s/^autoupdater\.[^.]*\.name='\(.*\)'$/\1/p") \
			stable beta experimental testing broken nightly ; do
		case "$tried" in *" $br "*) continue ;; esac
		tried="$tried$br "
		rm -f "$mf"
		wget -q -O "$mf" "$dir/$br.manifest" 2>/dev/null || continue
		# Manche Server (imageslive) liefern fuer jeden Pfad 200 mit HTML:
		# ein Manifest ist es nur mit BRANCH-Zeile.
		grep -q "^BRANCH=" "$mf" || continue
		line="$(awk -v img="$img" '$1 == img && NF == 5 { print; exit }' "$mf")"
		[ -n "$line" ] || continue
		set -- $line
		src="$dir/$5"
		want_sha="$3"
		echo "flash: gefunden in $br.manifest: $5 (Version $2)"
		rm -f "$mf"
		return 0
	done
	rm -f "$mf"

	# Rueckfall: Verzeichnisliste des Servers
	if wget -q -O /tmp/flash.index "$dir/" 2>/dev/null ; then
		name="$(grep -o "[^\"'/<> ]*-$img-sysupgrade\.[^\"'<> ]*" /tmp/flash.index | head -n 1)"
		rm -f /tmp/flash.index
		if [ -n "$name" ] ; then
			src="$dir/$name"
			want_sha=''
			echo "flash: gefunden in der Verzeichnisliste: $name (ohne Manifest, keine sha256 zum Vergleich)"
			return 0
		fi
	fi
	echo "flash: kein Image fuer $img in $dir/ gefunden - nichts geflasht." >&2
	return 1
}

[ -n "$1" ] || usage
src="$1"
shift
want_sha=''

case "$src" in
	-*) usage ;;
	https://*)
		src="http://${src#https://}"
		echo "flash: lade per http statt https: $src"
		;;
esac

case "${FLASH_HOOKS:-auto}" in
	1) hooks=1 ;;
	0) hooks='' ;;
	*) hooks=''; [ "$(mem_avail)" -lt "$LOWMEM_KB" ] 2>/dev/null && hooks=1 ;;
esac

case "$src" in
	http://*)
		last="${src%/}"
		last="${last##*/}"
		case "$src" in
			*/) find_image "${src%/}" || exit 1 ;;
			*)
				case "$last" in
					*.*) ;;
					*) find_image "$src" || exit 1 ;;
				esac
				;;
		esac
		name="${src##*/}"
		name="${name%%\?*}"
		[ -n "$name" ] || name=sysupgrade.bin
		file="/tmp/$name"
		rm -f "$file"
		[ -n "$hooks" ] && stop_services
		echo "flash: lade nach $file"
		if ! wget -O "$file" "$src" ; then
			rm -f "$file"
			fail "Download fehlgeschlagen - nichts geflasht."
		fi
		;;
	*)
		file="$src"
		[ -f "$file" ] || { echo "flash: $file gibt es nicht." >&2; exit 1; }
		[ -n "$hooks" ] && stop_services
		;;
esac

size=$(wc -c < "$file")
avail=$(mem_avail)
sha=$(sha256sum "$file" | cut -d' ' -f1)
echo "flash: $file, $((size / 1024)) KiB, RAM verfuegbar noch ${avail:-?} KiB"
echo "flash: sha256 $sha"

if [ -n "$want_sha" ] && [ "$sha" != "$want_sha" ] ; then
	fail "sha256 passt nicht zum Manifest ($want_sha) - nichts geflasht.
flash: Die Datei bleibt in $file liegen (RAM, weg nach dem Neustart)."
fi

if ! sysupgrade -T "$@" "$file" ; then
	fail "sysupgrade -T lehnt das Image ab - nichts geflasht.
flash: Die Datei bleibt in $file liegen (RAM, weg nach dem Neustart)."
fi

# Erst mit dem Image in /tmp knapp geworden: die Dienste jetzt anhalten.
if [ -z "$hooks" ] && [ "${FLASH_HOOKS:-auto}" != 0 ] && [ "${avail:-0}" -lt "$LOWMEM_AFTER_KB" ] 2>/dev/null; then
	hooks=1
	stop_services
fi

if [ -z "$hooks" ]; then
	echo "flash: Image passt. sysupgrade $* $file"
	exec sysupgrade "$@" "$file"
fi

say "Image passt. Weiter ohne diese Sitzung: gleich gehen WLAN und Netz aus"
echo "flash: (wie beim Autoupdater), die Verbindung bricht ab. Danach flasht der"
echo "flash: Knoten und startet neu. Log: $LOG und logread -e flash; bricht"
echo "flash: sysupgrade ab, kommen Netz und Dienste von selbst wieder."
: > "$LOG"
# -b: eigene Session, ueberlebt das Ende der SSH-Sitzung. Mit frischem
# Pidfile, denn ohne vergleicht start-stop-daemon ueber das Programm, und
# /bin/sh ist busybox - jede laufende Shell gaelte als "laeuft schon".
rm -f /tmp/flash.pid
start-stop-daemon -S -b -m -p /tmp/flash.pid -x /bin/sh -- "$0" --detached "$file" "$@" ||
	fail "konnte den Rest nicht losgeloest starten - nichts geflasht."
exit 0
