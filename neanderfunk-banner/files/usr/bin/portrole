#!/bin/sh
# portrole - zeigt oder setzt die Gluon-Rolle eines Interfaces.
#
#   portrole                   Rollen aller Interfaces zeigen, dazu Ports ohne Sektion
#   portrole lan mesh          LAN auf Mesh
#   portrole wan uplink mesh   WAN auf Uplink und Mesh (Mesh-on-WAN)
#   portrole lan none          LAN ohne Rolle
#   portrole eth2 client       weiterer Port (x86 eth2, VLAN eth0.8 ...) als Client
#   portrole eth2 none         dessen Sektion wieder entfernen
#   ... -y                     ohne Rueckfrage, auch bei riskanten Wechseln
#
# Ersetzt lanrole/wanrole (bis September 2026).
#
# Gluon kennt nur drei Gruppen aus board.json: /lan, /wan, /single. Jeder
# weitere Port (auf x86 alles ab eth2) gehoert zu keiner und tut nichts, bis
# er eine eigene Sektion gluon.iface_<port> mit Rolle hat ("." wird "_").
# Nur so uebersteht er gluon-reconfigure - ein Port, der von Hand in
# network.client steht, ist nach dem naechsten Update weg (Kollektor-Gluon
# 839d, 27.09.2026). Ports, die in der LAN- oder WAN-Gruppe stecken (DSA lan3),
# lassen sich so nicht herausnehmen: Werkstatt-Anleitung "LAN-Ports trennen".
#
# Rollen wie in Gluons Erweiterten Einstellungen: uplink, mesh, client;
# client nur allein, uplink+mesh geht. Geschrieben wird gluon.iface_<if>.role,
# wirksam erst nach gluon-reconfigure und Neustart - dafuer gibt es "reconf".
# Auf Geraeten mit nur einem Port gibt es nur iface_single.
#
# Ohne Rolle zeigt es auch weitere Sektionen (iface_client ...) und eigene
# Mesh-Ports in network. Eine Rolle fuer Ports, die dort schon eine haben,
# setzt es nicht.

NAME=${0##*/}
usage() {
	echo "Aufruf: portrole [lan|wan|single|<port>|<sektion> [uplink|mesh|client|none ...] [-y]]" >&2
	echo "        ohne Argument: Rollen aller Interfaces zeigen" >&2
	exit 1
}
case "${1:-}" in
	-h|--help) usage ;;
	-*) usage ;;
esac
# ohne Argument nur anzeigen (dafuer reicht irgendeine gueltige Sektion)
ARGC=$#
IF=${1:-lan}
[ $# -gt 0 ] && shift

YES=0
ROLES=
for a in "$@"; do
	case "$a" in
		-y) YES=1 ;;
		*) ROLES="$ROLES $(echo "$a" | tr ',+' '  ')" ;;
	esac
done

# Ports einer Gluon-Sektion: "/lan" usw. verweisen auf sysconfig
ports_of() {
	local n
	n=$(uci -q get gluon.$1.name)
	case "$n" in
		/*) cat "/lib/gluon/core/sysconfig/${n#/}_ifname" 2>/dev/null ;;
		*) echo "$n" ;;
	esac
}

gluon_sections() {
	uci -q show gluon | sed -n 's/^gluon\.\([^.=]*\)=interface$/\1/p'
}

# eigene Mesh-Ports in network (proto gluon_wired, gluon_preserve=1), wie sie
# die Werkstatt-Anleitung "LAN-Ports trennen" anlegt
own_mesh_sections() {
	uci -q show network | sed -n "s/^network\.\([^.=]*\)\.gluon_preserve='1'$/\1/p" | while read -r s; do
		[ "$(uci -q get network.$s.proto)" = gluon_wired ] && echo "$s"
	done
}

show() {
	for s in $(gluon_sections); do
		printf '%-12s %-14s %s\n' "${s#iface_}" "$(uci -q get gluon.$s.role || echo '(keine)')" "$(ports_of $s)"
	done
	for s in $(own_mesh_sections); do
		printf '%-12s %-14s %s\n' "$s" 'mesh (eigen)' "$(uci -q get network.$s.ifname || uci -q get network.$s.device)"
	done
	# Ethernet-Ports ohne Sektion (x86 eth2 ...): kein WLAN, kein DSA-Conduit
	local known p
	# echo ohne Anfuehrungszeichen macht aus Zeilenumbruechen Leerzeichen
	known=" $(echo $(for s in $(gluon_sections); do ports_of $s; done) $(for s in $(own_mesh_sections); do uci -q get network.$s.ifname; uci -q get network.$s.device; done)) "
	for p in $(ls /sys/class/net); do
		[ -e /sys/class/net/$p/device ] || continue
		[ -e /sys/class/net/$p/dsa ] && continue
		grep -q DEVTYPE=wlan /sys/class/net/$p/uevent 2>/dev/null && continue
		case "$known" in *" $p "*) continue ;; esac
		# Traeger von VLANs mit Rolle (swconfig: eth0 unter eth0.1/eth0.2)
		case "$known" in *" $p."*) continue ;; esac
		# wie nodestatus: nur auf x86 oder mit Link - manche Router haben eine
		# zweite, intern verdrahtete Schnittstelle ohne Buchse (MT7621 eth1)
		if ! grep -q "DISTRIB_TARGET='x86/" /etc/openwrt_release 2>/dev/null; then
			[ "$(cat /sys/class/net/$p/carrier 2>/dev/null)" = 1 ] || continue
		fi
		printf '%-12s %-14s %s\n' "$p" '(ohne Sektion)' "setzen: portrole $p <rolle>"
	done
}

# Ports, die ausser $1 schon eine Rolle haben: andere Gluon-Sektionen mit
# Rolle und eigene Mesh-Ports
ports_elsewhere() {
	local s
	for s in $(gluon_sections); do
		[ "$s" = "$1" ] && continue
		[ -n "$(uci -q get gluon.$s.role)" ] && echo "$(ports_of $s) "
	done
	for s in $(own_mesh_sections); do
		echo "$(uci -q get network.$s.ifname || uci -q get network.$s.device) "
	done
}

SEC=iface_$(echo "$IF" | tr '.-' '__')
NEWSEC=0
case "$IF" in
	lan|wan|single)
		if ! uci -q get gluon.$SEC >/dev/null; then
			if uci -q get gluon.iface_single >/dev/null; then
				[ $ARGC -gt 0 ] && echo "Geraet mit nur einem Port: es gibt nur iface_single."
				SEC=iface_single
				IF=single
			else
				echo "gluon.$SEC gibt es nicht." >&2
				exit 1
			fi
		fi
		;;
	*)
		# weitere Sektion (iface_eth2, iface_mesh aus der Anleitung ...) oder
		# ein Port, fuer den es noch keine gibt
		if ! uci -q get gluon.$SEC >/dev/null; then
			if [ ! -e "/sys/class/net/$IF" ] && [ ! -e "/sys/class/net/${IF%%.*}" ]; then
				echo "$IF: weder eine Sektion gluon.$SEC noch ein Port dieses Namens." >&2
				echo "Belegung und freie Ports zeigt: portrole" >&2
				exit 1
			fi
			NEWSEC=1
		fi
		;;
esac

if [ -z "$(echo $ROLES)" ]; then
	show
	exit 0
fi

# Neue Sektion: der Port selbst ist ihr Name
if [ $NEWSEC = 1 ]; then
	PORTNAME=$IF
fi
ports_of_target() {
	if [ $NEWSEC = 1 ]; then echo "$PORTNAME"; else ports_of $SEC; fi
}

# pruefen und normalisieren (Reihenfolge wie in Gluon: uplink mesh client)
NEW=
NONE=0
for r in $ROLES; do
	case "$r" in
		uplink|mesh|client) ;;
		none) NONE=1; continue ;;
		*) echo "Unbekannte Rolle: $r (erlaubt: uplink, mesh, client, none)" >&2; exit 1 ;;
	esac
done
for r in uplink mesh client; do
	case " $ROLES " in *" $r "*) NEW="$NEW $r" ;; esac
done
NEW=$(echo $NEW)
if [ $NONE = 1 ] && [ -n "$NEW" ]; then
	echo "none laesst sich nicht mit anderen Rollen kombinieren." >&2; exit 1
fi
case " $NEW " in
	*" client "*) [ "$NEW" = client ] || { echo "client laesst sich nicht mit uplink oder mesh kombinieren." >&2; exit 1; } ;;
esac

CUR=$(uci -q get gluon.$SEC.role)
if [ "$NEW" = "$CUR" ]; then
	echo "$IF: unveraendert (${CUR:-keine})"
	exit 0
fi

# Ports, die schon anderswo eine Rolle haben, bekaemen sonst zwei - Gluon
# nimmt dann irgendeine davon. Das laesst sich auch mit -y nicht erzwingen.
if [ -n "$NEW" ]; then
	ELSE=" $(echo $(ports_elsewhere $SEC)) "
	CLASH=
	for p in $(ports_of_target); do
		case "$ELSE" in *" $p "*) CLASH="$CLASH $p" ;; esac
	done
	if [ -n "$CLASH" ]; then
		echo "$IF: nicht gesetzt - diese Ports haben schon eine andere Rolle:$CLASH" >&2
		echo "Belegung zeigt: ${NAME}   (aufraeumen: Werkstatt-Anleitung \"LAN-Ports trennen\", Schritt 3)" >&2
		exit 1
	fi
fi

# riskant: danach hat kein Interface mehr uplink, oder dieses verliert mesh
RISK=
case " $CUR " in
	*" uplink "*)
		case " $NEW " in *" uplink "*) ;; *)
			OTHER=0
			for s in $(gluon_sections); do
				[ $s = $SEC ] && continue
				case " $(uci -q get gluon.$s.role) " in *" uplink "*) OTHER=1 ;; esac
			done
			[ $OTHER = 0 ] && RISK="danach hat KEIN Interface mehr die Rolle uplink - der Knoten verliert seinen Uplink"
		;; esac ;;
esac
case " $CUR " in
	*" mesh "*) case " $NEW " in *" mesh "*) ;; *) RISK="${RISK:+$RISK; }$IF verliert die Rolle mesh - Nachbarn ueber Kabel sind dann weg" ;; esac ;;
esac

echo "$IF: ${CUR:-(keine)} -> ${NEW:-(keine)}"
if [ -n "$RISK" ] && [ $YES = 0 ]; then
	echo "Achtung: $RISK." >&2
	echo "Wer ueber diesen Weg verbunden ist, ist nach reconf draussen." >&2
	if [ -t 0 ]; then
		printf 'Trotzdem setzen? [j/N] '
		read -r ANTWORT
		case "$ANTWORT" in j|J|ja|Ja) ;; *) echo "Nichts geaendert."; exit 1 ;; esac
	else
		echo "Nicht interaktiv: mit -y bestaetigen. Nichts geaendert." >&2
		exit 1
	fi
fi

case "$SEC" in
	iface_lan|iface_wan|iface_single)
		uci -q delete gluon.$SEC.role
		for r in $NEW; do uci add_list gluon.$SEC.role=$r; done
		;;
	*)
		if [ -z "$NEW" ]; then
			# Zusatzsektion ohne Rolle hat keinen Zweck: ganz weg
			uci -q delete gluon.$SEC
			echo "gluon.$SEC entfernt."
		else
			if [ $NEWSEC = 1 ]; then
				uci set gluon.$SEC=interface
				uci set gluon.$SEC.name="$PORTNAME"
				echo "gluon.$SEC angelegt (name=$PORTNAME)."
			fi
			uci -q delete gluon.$SEC.role
			for r in $NEW; do uci add_list gluon.$SEC.role=$r; done
		fi
		;;
esac
uci commit gluon
echo "Gesetzt. Wirksam nach gluon-reconfigure und Neustart: reconf"
