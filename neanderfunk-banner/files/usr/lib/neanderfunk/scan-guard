#!/bin/sh
# scan-guard <radio> [<radio> ...] - nach einem WLAN-Scan pruefen, ob die
# gescannten Radios noch Unicast koennen, sonst sofort das WLAN neu starten.
# Aufgerufen von channel (autofix, mesh) und offlinescan nach ihren Scans.
#
# Warum: Am MERCUSYS MR90X (MT7986) unter Gluon 2023.2 legte jeder Scan
# (iw scan lowpri wie iwinfo scan) das gescannte Radio fuer Unicast lahm,
# 20 von 20 Versuchen am 29.09.2026. Broadcast lief weiter: batman-Nachbarn
# blieben sichtbar (TQ 254 beim Nachbarn), alle Plinks ESTAB, die eigene
# Sendestatistik meldete Erfolg. Nichts heilt das von selbst; "wifi down;
# wifi up" behebt es. Unter Gluon 2025.1.3 trat es nicht auf (0 von 20),
# der Guard bleibt trotzdem drin.
#
# Da die batman-Nachbarn sichtbar bleiben, reicht es nicht, sie zu zaehlen:
# je Radio werden bis zu drei batman-Nachbarn auf seinem Mesh-Interface per
# ping6 an ihre Link-Local-Adresse (EUI-64 aus der Nachbar-MAC) angepingt,
# direkt auf dem Interface. Eine Antwort genuegt. Antwortet keiner, gibt es
# keine batman-Nachbarn oder kein Mesh-Interface auf dem Radio, wird das WLAN
# einmal neu gestartet - auch wenn Clients dranhaengen.
#
# Wartefenster: Nach einem WLAN-Neustart (channel baut ein Radio nach dem
# Kanalwechsel mit "wifi up" neu auf) antwortet Unicast erst nach 20-40 s,
# obwohl die Plinks laengst ESTAB sind (WR3000S, 29.09.2026). Deshalb je Radio
# bis zu GUARD_WAIT Sekunden (Vorgabe 60) alle 5 s erneut pruefen, bevor es
# als Ausfall zaehlt. Der echte Ausfall bleibt dabei tot und wird nur etwas
# spaeter behoben.

TAG=scan-guard

ll_of_mac() { # aa:bb:cc:dd:ee:ff -> fe80::a8bb:ccff:fedd:eeff
	oldifs="$IFS" ; IFS=:
	set -- $1
	IFS="$oldifs"
	[ $# -eq 6 ] || return 1
	printf 'fe80::%x%s:%sff:fe%s:%s%s\n' $(( 0x$1 ^ 2 )) "$2" "$3" "$4" "$5" "$6"
}

mesh_dev() { # $1 radio -> Mesh-Interface, leer wenn keins aktiv
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.device='$1'$/\1/p") ; do
		case "$s" in
			mesh_radio*|ibss_radio*)
				case "$(uci -q get wireless.$s.disabled)" in 1|true|yes|on|enabled) continue ;; esac
				d=$(uci -q get wireless.$s.ifname)
				[ -n "$d" ] && [ -d "/sys/class/net/$d" ] && { echo "$d" ; return ; }
				;;
		esac
	done
}

# $1 dev -> 0 wenn einer von bis zu drei batman-Nachbarn per Unicast
# antwortet; setzt peers (Anzahl gefundener Nachbarn)
unicast_ok() {
	peers=0
	for mac in $(batctl n -H 2>/dev/null | awk -v d="$1" '$1 == d { print $2 }' | head -n 3) ; do
		ll=$(ll_of_mac "$mac") || continue
		peers=$((peers + 1))
		ping6 -c 2 -W 1 -w 3 -I "$1" "$ll" >/dev/null 2>&1 && return 0
	done
	return 1
}

GUARD_WAIT=${GUARD_WAIT:-60}
need=''
for radio in "$@" ; do
	dev=$(mesh_dev "$radio")
	if [ -z "$dev" ] ; then
		echo "$TAG: $radio: kein aktives Mesh-Interface, WLAN-Neustart zur Sicherheit"
		need="$need $radio"
		continue
	fi
	# Sekunden seit dem Boot statt Uhrzeit: springt die Uhr per NTP, wird die
	# Wartezeit sonst falsch (siehe neanderfunk-wifi-blackout, 04.10.2026).
	start=$(cut -d. -f1 /proc/uptime)
	ok=0
	while : ; do
		unicast_ok "$dev" && { ok=1 ; break ; }
		[ $(( $(cut -d. -f1 /proc/uptime) - start )) -ge "$GUARD_WAIT" ] && break
		sleep 5
	done
	waited=$(( $(cut -d. -f1 /proc/uptime) - start ))
	if [ $ok = 1 ] ; then
		after=''
		[ "$waited" -ge 5 ] && after=" (nach ${waited}s)"
		echo "$TAG: $radio ($dev): Unicast zu batman-Nachbarn in Ordnung$after"
	elif [ "$peers" -eq 0 ] ; then
		echo "$TAG: $radio ($dev): keine batman-Nachbarn (${waited}s gewartet), WLAN-Neustart zur Sicherheit"
		need="$need $radio"
	else
		echo "$TAG: $radio ($dev): keiner von $peers batman-Nachbarn antwortet per Unicast (${waited}s gewartet)"
		need="$need $radio"
	fi
done

[ -n "$need" ] || exit 0

echo "$TAG: wifi down; wifi up (wegen$need) ..."
logger -t "$TAG" -p 5 "after scan: unicast check failed on$need, restarting wifi"
# Unter demselben Lock wie ssid-changer, hotfix, linkcheck und channel,
# wartend (busybox-flock kennt kein -w).
flock /var/lock/neanderfunk-wifi.lock -c 'wifi down; sleep 3; wifi up'
exit 1
