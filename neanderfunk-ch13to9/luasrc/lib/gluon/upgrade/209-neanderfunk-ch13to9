#!/usr/bin/lua
-- Move a 2.4 GHz radio off channel 13 onto channel 9, even where the site keeps
-- wifi channels across upgrades. Certain Android devices refuse to work on
-- channel 13 in the EU regulatory domain.
--
-- Runs from /lib/gluon/upgrade, so on every gluon-reconfigure: every firmware
-- upgrade, the end of setup mode, and a domain switch. That is the right place
-- for it; there is nothing to run "once" here, because the channel can be set
-- back at any time and moving it again is idempotent.
--
-- Two defects fixed, both of the kind this feed has seen before:
--
--   * The radios were selected by "uci:get('wireless','radio0','hwmode')".
--     OpenWrt 21.02 replaced hwmode with band, so on every current node that
--     returns nil, the whole detection block was skipped, and the package did
--     nothing at all - the same way neanderfunk-ath9kblackout was dead. Now it
--     asks band and accepts hwmode as the older spelling.
--   * The package shipped this file and a byte-identical copy under
--     /lib/gluon/ch13to9/ch13to9.lua, the latter called by a self-deleting
--     /etc/init.d/ch13to9 whose gate was "if [ $(uci get ...enabled) ]" - a
--     bare string test, true for "0" as much as for "1". Exactly the pattern
--     neanderfunk-txpowerfix had. Both are gone; this file is the only copy.
--
-- The old version also walked radio0/radio1 by hand to work out which one was
-- 2.4 GHz. Iterating the wifi-device sections does the same thing and copes
-- with a node that has one radio, three, or none.

local uci = require('simple-uci').cursor()

-- 2.4 GHz? band is the current spelling, hwmode the pre-21.02 one.
local function is_24ghz(radio)
	local band = uci:get('wireless', radio, 'band')
	if band then
		return band == '2g'
	end
	return uci:get('wireless', radio, 'hwmode') == '11g'
end

local changed = false

uci:foreach('wireless', 'wifi-device',
	function(s)
		local radio = s['.name']
		if not is_24ghz(radio) then
			return
		end
		-- tostring, because the channel may legitimately be "auto"
		if tostring(uci:get('wireless', radio, 'channel')) ~= '13' then
			return
		end
		uci:set('wireless', radio, 'channel', '9')
		changed = true
		os.execute('logger -s -t neanderfunk-ch13to9 -p 5 ' ..
			'"' .. radio .. ' was on channel 13, moved to 9"')
	end
)

if changed then
	uci:save('wireless')
	uci:commit('wireless')
end
