# neanderfunk-domainhelper
#
# bridge: Domain-Bruecken am LAN-Mesh trennen (neanderfunk-domainhelper
# bridge, jede Minute). cut '0' schaltet nur das Trennen ab; erkannt und
# gemeldet (Syslog, Banner) wird trotzdem.
config bridge 'bridge'
	option cut '1'

# island: Insel ohne Gateway - nach 60 min Kanal auf ein Mesh der eigenen
# Domain, nach 600 min Domain und Kanal wechseln. enabled '0' schaltet es ab.
config island 'island'
	option enabled '1'
