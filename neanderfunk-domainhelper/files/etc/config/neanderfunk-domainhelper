# neanderfunk-domainhelper
#
# bridge: Domain-Bruecken am LAN-Mesh trennen (neanderfunk-domainhelper
# bridge, jede Minute). cut '0' schaltet nur das Trennen ab; erkannt und
# gemeldet (Syslog, Banner) wird trotzdem.
config bridge 'bridge'
	option cut '1'

# island: Insel ohne Gateway - nach 60 min Kanal auf ein Mesh der eigenen
# Domain, nach 600 min Domain und Kanal wechseln (in 25_hvb beides nach
# 5 min). enabled '0' schaltet es ab.
config island 'island'
	option enabled '1'

# follow: ohne eigenes VPN der Domain folgen, aus der das Netz kommt (Nachbar
# am Kabel mit VPN in fremder Domain, oder nur fremde Gateways), nach 60 min.
# enabled '0' schaltet es ab.
config follow 'follow'
	option enabled '1'
