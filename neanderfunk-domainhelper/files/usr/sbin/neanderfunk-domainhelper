#!/usr/bin/lua
-- SPDX-License-Identifier: BSD-3-Clause
--
-- neanderfunk-domainhelper: Hilfen rund um die Domain eines Knotens.
--
-- Bisher ein Unterbefehl, "locate": Lokator und Abschleppdienst fuer die
-- Halteverbots-Defaultdomain. Scannt die WLANs in der Umgebung und meldet
-- sie per POST an den Locator. Der Knoten wertet die Antwort nicht aus.
--
-- Eingeschaltet nur ueber die Domain-Datei: Steht in der aktiven Domain
-- neanderfunk_domainhelper.locator.urls, meldet der Knoten dorthin. Fehlt der
-- Schluessel (jede andere Domain), tut das Skript nichts. Im Code steht
-- keine Domain.
--
-- Einzige eigene Entscheidung: Ist die Ortung an und haengen am LAN-Mesh
-- Nachbarn genau einer anderen Domain, die im Image steht, schaltet der
-- Knoten nach der Meldung selbst in diese Domain um (gluon-switch-domain,
-- Neustart). Ohne VXLAN sind die batman-Wolken dann ohnehin schon verbunden.
--
-- Konzept: docs/konzept-hvb-ortung.md, Format v1 (Abschnitt 4.3).
--
-- Aufruf (gestartet wird es sonst von locate.sh, beim Start und taeglich):
--   neanderfunk-domainhelper locate            scannen und melden
--   neanderfunk-domainhelper locate -n         nur scannen, JSON ausgeben,
--                                              nichts senden
--   neanderfunk-domainhelper locate -u <url>   an diese URL melden, auch ohne
--                                              den Schluessel in der Domain
--                                              (schaltet dann nie)
--   neanderfunk-domainhelper locate -n -a <d>  zum Testen: so tun, als stuende
--                                              der Knoten in Domain <d> mit
--                                              eingeschalteter Ortung (nur mit
--                                              -n, schaltet nie)

local VERSION = '0.3'
local MAX_NETS = 50

local json = require 'jsonc'
local site = require 'gluon.site'

local function sh(cmd)
	local f = io.popen(cmd .. ' 2>/dev/null')
	if not f then return '' end
	local out = f:read('*a') or ''
	f:close()
	return out
end

local function readfile(path)
	local f = io.open(path)
	if not f then return nil end
	local s = f:read('*a')
	f:close()
	return s
end

local function trim(s)
	return (s or ''):match('^%s*(.-)%s*$')
end

local function log(msg)
	os.execute("logger -t neanderfunk-domainhelper '" .. msg:gsub("'", '') .. "'")
end

-- Argumente: erst der Unterbefehl, bisher nur "locate"
local USAGE = 'usage: neanderfunk-domainhelper locate [-n] [-u url] [-a domain]\n'
if arg[1] ~= 'locate' then
	io.stderr:write(USAGE)
	os.exit(2)
end
local dry, url_override, as_domain = false, nil, nil
do
	local i = 2
	while arg[i] do
		if arg[i] == '-n' then
			dry = true
		elseif arg[i] == '-u' and arg[i + 1] then
			url_override = arg[i + 1]
			i = i + 1
		elseif arg[i] == '-a' and arg[i + 1] then
			as_domain = arg[i + 1]
			i = i + 1
		else
			io.stderr:write(USAGE)
			os.exit(2)
		end
		i = i + 1
	end
	if as_domain and not dry then
		io.stderr:write('neanderfunk-domainhelper: -a nur zusammen mit -n\n')
		os.exit(2)
	end
end

-- Eigene WLAN-Interfaces: Typ und MAC, je phy
local function wifi_interfaces()
	local list, cur = {}, nil
	for line in sh('iw dev'):gmatch('[^\n]+') do
		local name = line:match('^%s*Interface%s+(%S+)')
		if name then
			cur = { name = name }
			table.insert(list, cur)
		elseif cur then
			local mac = line:match('^%s*addr%s+(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)')
			if mac then cur.mac = mac:lower() end
			local typ = line:match('^%s*type%s+(.+)$')
			if typ then cur.type = trim(typ) end
			local mhz = line:match('%((%d+) MHz%)')
			if mhz and not cur.freq then cur.freq = tonumber(mhz) end
		end
	end
	return list
end

-- Je Band ein Interface zum Scannen: Mesh-Punkt zuerst, dann Station,
-- zuletzt AP (der braucht ap-force).
local function scan_targets(ifaces)
	local rank = { ['mesh point'] = 1, managed = 2, AP = 3 }
	local best = {}
	for _, i in ipairs(ifaces) do
		local band = (i.freq or 0) >= 4000 and '5' or '2.4'
		local r = rank[i.type or '']
		if r and (not best[band] or r < best[band].r) then
			best[band] = { r = r, iface = i }
		end
	end
	local out = {}
	for _, b in pairs(best) do table.insert(out, b.iface) end
	table.sort(out, function(a, b) return a.name < b.name end)
	return out
end

local function parse_scan(text, nets)
	local cur
	for line in text:gmatch('[^\n]+') do
		local bssid = line:match('^BSS%s+(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)')
		if bssid then
			cur = { bssid = bssid:lower(), ssid = '', mesh_id = '' }
			table.insert(nets, cur)
		elseif cur then
			local v
			v = line:match('^\tfreq:%s*([%d%.]+)')
			if v then cur.freq = math.floor(tonumber(v) + 0.5) end
			v = line:match('^\tsignal:%s*(%-?[%d%.]+)%s*dBm')
			if v then cur.signal = math.floor(tonumber(v) + 0.5) end
			v = line:match('^\tlast seen:%s*(%d+)%s*ms ago')
			if v then cur.age_ms = tonumber(v) end
			v = line:match('^\tSSID: ?(.*)$')
			if v then cur.ssid = v end
			v = line:match('^\tMESH ID: ?(.*)$')
			if v then cur.mesh_id = v end
		end
	end
end

local ifaces = wifi_interfaces()
local own = {}
for _, i in ipairs(ifaces) do
	if i.mac then own[i.mac] = true end
end

local scans, raw = {}, {}
for _, i in ipairs(scan_targets(ifaces)) do
	local cmd = 'iw dev ' .. i.name .. ' scan'
	local text = sh(cmd)
	if not text:match('^BSS') and i.type == 'AP' then
		text = sh(cmd .. ' ap-force')
	end
	local before = #raw
	parse_scan(text, raw)
	table.insert(scans, { iface = i.name, ok = text:match('^BSS') ~= nil, count = #raw - before })
end

-- Filtern: eigene Interfaces, _nomap, Eintraege ohne Pegel; doppelte BSSIDs
-- (auf zwei Interfaces gesehen) nur einmal, mit dem staerkeren Pegel
local by_bssid = {}
for _, n in ipairs(raw) do
	if n.signal and not own[n.bssid] and not n.ssid:match('_nomap$') then
		local old = by_bssid[n.bssid]
		if not old or n.signal > old.signal then
			by_bssid[n.bssid] = n
		end
	end
end
local wifi = {}
for _, n in pairs(by_bssid) do table.insert(wifi, n) end
table.sort(wifi, function(a, b) return a.signal > b.signal end)
while #wifi > MAX_NETS do table.remove(wifi) end

-- Exit-IPv4 ueber das WAN, so wie nodestatus sie ermittelt. Ohne IPv4-Uplink
-- (etwa ein reiner Mesh-Knoten) bleibt das Feld weg.
local function public_v4()
	for _, u in ipairs({ 'http://ipv4.icanhazip.com', 'http://checkip.amazonaws.com' }) do
		local a = trim(sh('uclient-fetch -4 -q -T 5 -O - ' .. u))
		local o = { a:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$') }
		if #o == 4 then
			local ok = true
			for _, x in ipairs(o) do if tonumber(x) > 255 then ok = false end end
			if ok then return a end
		end
	end
	return nil
end

-- Uplink: Hat der Knoten selbst einen VPN-Uplink, und ueber welches
-- Interface laeuft sein Gateway? Ein Knoten ohne eigenen VPN-Uplink haengt
-- per WLAN- oder LAN-Mesh an anderen und darf nicht allein verschoben werden
-- (Konzept 4.4). Wer ueber ihn ins Netz geht, sieht der Locator aus den
-- Kartendaten; hier stehen nur die Zahlen der Nachbarn je Art.
local function uplink()
	local n = { vpn = 0, wifi = 0, lan = 0 }
	for line in sh('batctl n -H'):gmatch('[^\n]+') do
		local ifname = line:match('^%s*(%S+)%s+%x%x:')
		if ifname == 'mesh-vpn' then
			n.vpn = n.vpn + 1
		elseif ifname and ifname:match('^mesh%d+$') then
			n.wifi = n.wifi + 1
		elseif ifname then
			n.lan = n.lan + 1
		end
	end
	-- "* <gateway> (tq) <next hop> [ <if>]: ..."
	local gw = sh('batctl gwl -H'):match('^%*[^\n]*')
	local nexthop, via
	if gw then
		nexthop, via = gw:match('%)%s+(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)%s+%[%s*(%S+)%]')
	end
	-- MACs der eigenen batman-Interfaces: daran erkennt der Locator, wenn
	-- ein anderer HVB-Knoten ohne VPN diesen Knoten als Next Hop meldet
	local macs = {}
	for line in sh('batctl if'):gmatch('[^\n]+') do
		local ifname = line:match('^(%S+):')
		local mac = ifname and trim(readfile('/sys/class/net/' .. ifname .. '/address'))
		if mac and mac:match('^%x%x:') then table.insert(macs, mac:lower()) end
	end
	return {
		vpn = n.vpn > 0,
		gw_via = via,
		gw_nexthop = nexthop and nexthop:lower(),
		mesh_macs = macs,
		neighbours = n,
	}
end

-- LAN-Mesh: alle batman-Interfaces ausser mesh-vpn und den WLAN-Meshes.
-- Je Interface die direkten Nachbarn per respondd fragen (wie die
-- Statusseite). Die Domain steht in system.domain_code; aeltere
-- Single-Domain-Images haben das Feld nicht, dann der Teil des site_code
-- hinter dem Bindestrich (nef-21_dias, bgl-43_bggl).
--
-- Die Antworten kommen nicht sofort: Auf der Statusseite stehen Nachbarn
-- oft bis zu 30 s nur als MAC da. Deshalb wird wiederholt gefragt, bis
-- jeder batman-Nachbar am LAN geantwortet hat (erkannt an seinen MACs in
-- network.mesh), hoechstens LAN_WAIT Sekunden lang.
local LAN_WAIT = 60

local function nodeinfo_macs(ni)
	local macs = {}
	local mesh = type(ni.network) == 'table' and ni.network.mesh
	if type(mesh) ~= 'table' then return macs end
	for _, bat in pairs(mesh) do
		local ifs = type(bat) == 'table' and bat.interfaces
		if type(ifs) == 'table' then
			for _, list in pairs(ifs) do
				if type(list) == 'table' then
					for _, m in ipairs(list) do
						if type(m) == 'string' then macs[m:lower()] = true end
					end
				end
			end
		end
	end
	return macs
end

local function lan_mesh(own_id)
	local ifs, pending, npending = {}, {}, 0
	for line in sh('batctl n -H'):gmatch('[^\n]+') do
		local ifname, mac = line:match('^%s*(%S+)%s+(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)')
		if ifname and ifname ~= 'mesh-vpn' and not ifname:match('^mesh%d+$') then
			if not pending[ifname] then
				pending[ifname] = {}
				table.insert(ifs, ifname)
			end
			mac = mac:lower()
			if not pending[ifname][mac] then
				pending[ifname][mac] = true
				npending = npending + 1
			end
		end
	end

	local out, by_key = {}, {}
	local deadline = os.time() + LAN_WAIT
	while npending > 0 and os.time() < deadline do
		for _, ifname in ipairs(ifs) do
			if next(pending[ifname]) then
				local text = sh('gluon-neighbour-info -i ' .. ifname
					.. ' -d ff02::2:1001 -p 1001 -t 5 -r nodeinfo')
				for line in text:gmatch('[^\n]+') do
					local ni = json.parse(line)
					local id = type(ni) == 'table' and type(ni.node_id) == 'string'
						and ni.node_id:lower()
					if id and id ~= own_id then
						local e = by_key[ifname .. id]
						if not e then
							local sys = type(ni.system) == 'table' and ni.system or {}
							local dom = type(sys.domain_code) == 'string' and sys.domain_code
								or (type(sys.site_code) == 'string'
									and sys.site_code:match('^[^-]+%-(.+)$'))
								or nil
							e = { iface = ifname, node_id = id, domain = dom }
							by_key[ifname .. id] = e
							table.insert(out, e)
						end
						for m in pairs(nodeinfo_macs(ni)) do
							if pending[ifname][m] then
								pending[ifname][m] = nil
								npending = npending - 1
								e.mac = m
							end
						end
					end
				end
			end
		end
	end
	-- Wer bis zum Schluss nicht geantwortet hat, steht nur mit MAC da
	for _, ifname in ipairs(ifs) do
		for m in pairs(pending[ifname]) do
			table.insert(out, { iface = ifname, mac = m })
		end
	end
	return out
end

-- Umschalten nur, wenn genau eine fremde Domain am Kabel haengt, sie im
-- Image steht und es keine weitere fremde Domain gibt (auch keine, die das
-- Image nicht kennt). Nachbarn ohne Domainangabe zaehlen nicht.
local function lan_target(neigh, own_domain)
	local doms, n = {}, 0
	for _, x in ipairs(neigh) do
		if x.domain and x.domain ~= own_domain and not doms[x.domain] then
			doms[x.domain] = true
			n = n + 1
		end
	end
	if n ~= 1 then return nil end
	local d = next(doms)
	if not d:match('^[%w_%-]+$') then return nil end
	local f = io.open('/lib/gluon/domains/' .. d .. '.json')
	if not f then return nil end
	f:close()
	return d
end

-- Ortung an? Nur, wenn die aktive Domain die URLs mitbringt (gluon.site
-- fuehrt Site und aktive Domain zusammen).
local site_urls = site.neanderfunk_domainhelper.locator.urls({})
local active = type(site_urls) == 'table' and #site_urls > 0
if not active and not dry and not url_override then
	os.exit(0)
end

local own_id = require('gluon.util').node_id():lower()
local own_domain = trim(sh('uci -q get gluon.core.domain'))
local lan = lan_mesh(own_id)
local switch_to
if as_domain then
	switch_to = lan_target(lan, as_domain)
elseif active then
	switch_to = lan_target(lan, own_domain)
end

local report = {
	v = 1,
	node_id = own_id,
	domain = own_domain,
	release = trim(readfile('/lib/gluon/release')),
	uptime = math.floor(tonumber((readfile('/proc/uptime') or '0'):match('^[%d%.]+')) or 0),
	scan = scans,
	wifi = wifi,
	uplink = uplink(),
	lan_mesh = lan,
	lan_switch = switch_to,
}

local v4 = public_v4()
if v4 then report.exit_ip = { ipv4 = v4 } end

local lat = tonumber(trim(sh('uci -q get gluon-node-info.@location[0].latitude')))
local lon = tonumber(trim(sh('uci -q get gluon-node-info.@location[0].longitude')))
if lat and lon then report.coordinates = { lat = lat, lon = lon } end

local body = json.stringify(report)

if dry then
	print(body)
	os.exit(0)
end

-- https nur mit TLS im Image
local have_tls = io.open('/lib/libustream-ssl.so') or io.open('/usr/lib/libustream-ssl.so')
if have_tls then have_tls:close() end

local urls = url_override and { url_override } or site_urls
local tmp = '/tmp/neanderfunk-domainhelper-locate.json'
local f = assert(io.open(tmp, 'w'))
f:write(body)
f:close()

local sent = false
for _, u in ipairs(urls) do
	if have_tls or not u:match('^https:') then
		-- uclient-fetch nimmt nur 200 als Erfolg; den 202 des Locators meldet
		-- es als "HTTP error 202" mit rc 8. Jede 2xx-Antwort gilt als
		-- angekommen.
		local out = sh('uclient-fetch -T 20 -O /dev/null'
			.. " -U 'neanderfunk-domainhelper/" .. VERSION .. "'"
			.. " --header='Content-Type: application/json'"
			.. " --post-file=" .. tmp .. " '" .. u .. "' 2>&1; echo \"rc=$?\"")
		if out:match('rc=0%s*$') or out:match('HTTP error 2%d%d') then
			log('gemeldet: ' .. #wifi .. ' Netze an ' .. u)
			sent = true
			break
		end
	end
end
os.remove(tmp)

if not sent then
	log('Meldung fehlgeschlagen (' .. #wifi .. ' Netze)')
end

-- Umschalten auch, wenn die Meldung nicht ankam: Der Bericht des Mapservers
-- ist Beiwerk, das Kabel entscheidet.
if switch_to then
	log('LAN-Mesh-Nachbarn in ' .. switch_to .. ', schalte von '
		.. own_domain .. ' dorthin um')
	os.execute('gluon-switch-domain ' .. switch_to)
	os.exit(0)
end

if not sent then os.exit(1) end
