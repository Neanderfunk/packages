#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
#
# neanderfunk-domainhelper: Hilfen rund um die Domain eines Knotens.
# Kurz: domainhelper (Symlink in /usr/sbin).
#
#   neanderfunk-domainhelper locate [-n] [-u url] [-a domain]
#       Lokator und Abschleppdienst fuer die Halteverbots-Defaultdomain
#       (nur aktiv, wenn die Domain neanderfunk_domainhelper.locator.urls
#       setzt). Gestartet von locate.sh nach dem Start und taeglich.
#           -n          nur scannen, JSON ausgeben, nichts senden
#           -u <url>    an diese URL melden, auch ohne den Schluessel in der
#                       Domain (schaltet dann nie)
#           -n -a <d>   so tun, als stuende der Knoten in Domain <d> mit
#                       eingeschalteter Ortung (schaltet nie)
#
#   neanderfunk-domainhelper island [-n]
#       Insel ohne Gateway: nach 60 min Kanal auf ein Mesh der eigenen
#       Domain stellen, nach 600 min Domain und Kanal wechseln. Alle 91 s
#       aus bridge-loop.sh. -n: Wartezeiten uebergehen, nur zeigen.
#
#   neanderfunk-domainhelper follow [-n]
#       Ohne eigenes VPN der Domain folgen, aus der das Netz kommt: Nachbar
#       am Kabel mit VPN in fremder Domain (R1) oder nur fremde Gateways
#       (R2), nach 60 min, WLAN-Kanaele bleiben. Alle 91 s aus
#       bridge-loop.sh. -n: Wartezeit uebergehen, nur zeigen.
#
#   neanderfunk-domainhelper bridge [-n]
#       Domain-Bruecken am LAN-Mesh erkennen und bis zum Neustart trennen,
#       alle 91 s aus bridge-loop.sh (procd). -n: nur zeigen, was passieren
#       wuerde.
#
# Bis 0.3 war das ein Lua-Skript. Seit 0.4 Shell; die Unterbefehle liegen in
# /lib/gluon/neanderfunk-domainhelper/cmd_<name>.sh, gemeinsame Funktionen
# in lib.sh. So laedt der Minutenlauf von "bridge" weder jshn noch locate.

VERSION=0.13

. /lib/gluon/neanderfunk/site.sh
. /lib/gluon/neanderfunk-domainhelper/lib.sh

cmd="$1"
[ $# -gt 0 ] && shift
case "$cmd" in
	locate) . /lib/gluon/neanderfunk-domainhelper/cmd_locate.sh ;;
	bridge) . /lib/gluon/neanderfunk-domainhelper/cmd_bridge.sh ;;
	island) . /lib/gluon/neanderfunk-domainhelper/cmd_island.sh ;;
	follow) . /lib/gluon/neanderfunk-domainhelper/cmd_follow.sh ;;
	*)
		echo 'usage: domainhelper locate [-n] [-u url] [-a domain]' >&2
		echo '       domainhelper bridge [-n]' >&2
		echo '       domainhelper island [-n]' >&2
		echo '       domainhelper follow [-n]' >&2
		exit 2
		;;
esac
