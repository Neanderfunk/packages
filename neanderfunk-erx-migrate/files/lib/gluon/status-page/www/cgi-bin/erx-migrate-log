#!/bin/sh
#
# Gibt /tmp/erx-migrate.log aus:
#
#   http://[<knoten>]/cgi-bin/erx-migrate-log
#
# Bewusst offen, wie die Statusseite daneben: Im Log steht nichts Vertrauliches -
# Partitionslayout, Groessen, Pruefsummen, Mirrors, Fehlermeldungen.
#
# Warum ueberhaupt ueber HTTP: die Karte zeigt keine unbekannten
# respondd-Felder an, und auf vielen Knoten haben wir keinen SSH-Zugang. Der Weg
# ist deshalb, in der Kartenstatistik die ERX ohne "-ka" im Imagenamen zu suchen
# und dort nachzusehen. Das sind so wenige, dass es von Hand geht.

set -u

LOG="/tmp/erx-migrate.log"

printf 'Content-Type: text/plain; charset=utf-8\r\n\r\n'

if [ -r "$LOG" ]; then
	cat "$LOG"
else
	echo "Kein Log vorhanden."
	echo
	echo "Entweder laeuft auf diesem Knoten keine Migration, oder sie ist seit"
	echo "dem letzten Neustart noch nicht angelaufen. Das Log liegt nur im RAM"
	echo "und ist nach einem Neustart weg - der naechste Versuch legt es neu an."
fi
