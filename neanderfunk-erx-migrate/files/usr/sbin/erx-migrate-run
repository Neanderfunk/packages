#!/bin/sh
#
# Stufe 2 der ERX-Migration: holt das 2025.1-Image und uebergibt an
# erx-migrate.sh.
#
# Stufe 1 ist das Zwischenimage selbst. Das kommt ueber den ganz normalen
# Autoupdater (2023.2 -> 2023.2, compat 1.x -> 1.x), bringt dieses Paket mit
# und startet es beim Boot ueber /etc/init.d/erx-migrate.
#
#
# Wovon nichts angefasst wird
# ---------------------------
# Kein Schreibzugriff aufs Flash, solange die Migration nicht wirklich losgeht.
# Das Log liegt in /tmp, das Image auch, und beides wird bei jedem Fehlschlag
# weggeraeumt - ein ERX hat 256 MB RAM, aber ein liegengebliebenes 7-MB-Image
# je Versuch summiert sich.
#
# Zustand ueber Neustarts hinweg gibt es deshalb nicht. Nach einem Reboot faengt
# alles von vorn an, auch nach einer dauerhaften Absage. Das ist gewollt: ein
# Neuversuch je Boot kostet nichts, und der Verzicht auf persistenten Zustand
# spart die ganze Frage, wann er wieder aufgeraeumt gehoert.
#
#
# Warum ueberhaupt
# ----------------
# Der Kernel 6.6 aus OpenWrt 24.10 ist 3.173.564 Bytes gross und passt damit um
# 27 KB nicht mehr in einen der beiden alten 3-MB-Slots. OpenWrt riegelt den
# Wechsel ueber compat_version 1.x -> 2.0 ab, und dieser Riegel greift erst in
# "sysupgrade --test", also nach dem vollstaendigen Download. Ein nicht
# migrierter Knoten wuerde bei jedem Autoupdater-Lauf dieselben 7 MB ziehen und
# dieselbe Absage bekommen - rund 690 MB am Tag, unsichtbar ausser in logread.

set -u
# Mirrors mit IPv6-Adresse enthalten eckige Klammern.
set -f

ZIEL="/lib/gluon/erx-migrate/ziel.conf"
MIGRATE="/lib/gluon/erx-migrate/erx-migrate.sh"
STAGE2="/lib/gluon/erx-migrate/erx-migrate-stage2.sh"

LOG="/tmp/erx-migrate.log"
IMAGE="/tmp/erx-migrate-image.bin"
LOCK="/tmp/erx-migrate.laeuft"
AUFGEGEBEN="/tmp/erx-migrate.aufgegeben"
UEBERGABE="/tmp/erx-migrate.uebergabe"
MANIFEST="/tmp/erx-migrate.manifest"
OBEN="/tmp/erx-migrate.manifest.oben"
UNTEN="/tmp/erx-migrate.manifest.unten"

# Das Image braucht Platz in /tmp, und dort liegt auch schon die
# Konfigurationssicherung, die erx-migrate.sh anlegt. 24 MB als Untergrenze
# sind reichlich fuer ein 7-MB-Image plus Entpacken.
PLATZ_MIN_KB=24576

protokoll() {
	printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}

# Zwei Arten von Ende, und der Unterschied entscheidet ueber den Neuversuch:
#
#   spaeter   voruebergehend - kein Uplink, Manifest noch nicht ausreichend
#             signiert, Mirror hinkt hinterher, Image fehlt oder ist kaputt.
#             micron.d versucht es in einer Stunde wieder.
#   endgueltig  aussichtslos bis zum naechsten Boot - Vorpruefung durchgefallen,
#             Migration nicht durchgefuehrt. Ein stuendlicher Neuversuch wuerde
#             daran nichts aendern und nur Traffic kosten.
spaeter() {
	protokoll "AUFSCHUB: $*"
	aufraeumen
	exit 0
}

endgueltig() {
	protokoll "ABBRUCH: $*"
	: > "$AUFGEGEBEN"
	aufraeumen
	exit 1
}

aufraeumen() {
	rm -f "$IMAGE" "$MANIFEST" "$OBEN" "$UNTEN"
	rmdir "$LOCK" 2>/dev/null
}

# Holt das Manifest von einem Mirror und prueft es wie der Autoupdater: Zweig
# und Signaturen, mit Schluesseln und Schwelle aus dessen Konfiguration.
manifest_pruefen() {
	local mirror="$1" sig key

	rm -f "$MANIFEST"
	if ! uclient-fetch -q -O "$MANIFEST" "$mirror/$NAME.manifest" 2>>"$LOG"; then
		protokoll "$mirror: kein Manifest."
		return 1
	fi

	: > "$OBEN"
	: > "$UNTEN"
	awk -v oben="$OBEN" -v unten="$UNTEN" \
		'BEGIN { t = 0 } /^---$/ { t = 1; next } { print > (t ? unten : oben) }' \
		"$MANIFEST"

	set --
	for sig in $(grep -E '^[0-9a-f]{128}$' "$UNTEN"); do
		set -- "$@" -s "$sig"
	done
	for key in $SCHLUESSEL; do
		set -- "$@" -p "$key"
	done
	if ! ecdsaverify "$@" -n "$SCHWELLE" "$OBEN" 2>>"$LOG"; then
		protokoll "$mirror: weniger als $SCHWELLE gueltige Signaturen."
		return 1
	fi

	if ! grep -qx "BRANCH=$NAME" "$OBEN"; then
		protokoll "$mirror: Manifest gehoert nicht zum Zweig $NAME."
		return 1
	fi
}

# Laedt das Image, das das gepruefte Manifest nennt. Erst wenn die Datei
# vollstaendig und richtig ist, wird migriert: ein Abbruch mitten im Download
# ergibt eine andere Summe.
image_holen() {
	local mirror="$1" ist

	# shellcheck disable=SC2046
	set -- $(awk -v modell="$MODELL" '$1 == modell { print; exit }' "$OBEN")
	if [ "$#" -ne 5 ]; then
		protokoll "$mirror: keine Manifestzeile fuer $MODELL."
		return 1
	fi
	SHA="$3"

	protokoll "Lade $5, Version $2."
	rm -f "$IMAGE"
	if ! uclient-fetch -q -O "$IMAGE" "$mirror/$5" 2>>"$LOG"; then
		protokoll "$mirror: Download fehlgeschlagen."
		return 1
	fi

	ist="$(wc -c < "$IMAGE")"
	if [ "$ist" != "$4" ]; then
		protokoll "$mirror: $ist Bytes statt $4."
		return 1
	fi
	ist="$(sha256sum "$IMAGE" | cut -d' ' -f1)"
	if [ "$ist" != "$SHA" ]; then
		protokoll "$mirror: Pruefsumme $ist statt $SHA."
		return 1
	fi
	protokoll "Geladen, Groesse und Pruefsumme stimmen."
}

# --- Voraussetzungen, alle ohne Schreibzugriff ---------------------------

[ -r "$ZIEL" ] || exit 0
# shellcheck source=/dev/null
. "$ZIEL"

case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	ubnt,edgerouter-x)
		MODELL="${ZIEL_MODELL_ERX:-}"
		;;
	ubnt,edgerouter-x-sfp)
		MODELL="${ZIEL_MODELL_ERX_SFP:-}"
		;;
	*)
		# Kein ERX. Kein Log, kein Marker - das Paket ist hier schlicht nicht
		# zustaendig und soll auch nichts hinterlassen.
		exit 0
		;;
esac

# Ohne Ziel tut das Paket nichts, ebenfalls ohne Log.
[ -n "$MODELL" ] || exit 0

[ -e "$AUFGEGEBEN" ] && exit 0

# Schon migriert? Dann gibt es nur noch eine Partition namens "kernel", nicht
# mehr kernel1 und kernel2. Der haeufigste Fall im Dauerbetrieb, deshalb frueh.
if grep -q '"kernel"' /proc/mtd 2>/dev/null; then
	exit 0
fi
grep -q '"kernel1"' /proc/mtd 2>/dev/null || {
	protokoll "Weder kernel noch kernel1 in /proc/mtd - unerwartetes Layout."
	: > "$AUFGEGEBEN"
	exit 1
}

# mkdir als Lock: atomar auch auf tmpfs, anders als "test -e und dann touch".
mkdir "$LOCK" 2>/dev/null || exit 0

[ -x "$MIGRATE" ] || endgueltig "$MIGRATE fehlt oder ist nicht ausfuehrbar."
[ -r "$STAGE2" ]  || endgueltig "$STAGE2 fehlt."

# --- Ab hier wird geredet ------------------------------------------------

: > "$LOG"
protokoll "Start. Board $(cat /tmp/sysinfo/board_name), Release $(cat /lib/gluon/release 2>/dev/null)"

# Vorpruefung des Migrationsskripts, bevor irgendetwas geladen wird. Sie
# schreibt nichts und sagt uns, ob Layout, Boot-Index und Waechter stimmen.
if ! pruefung="$(sh "$MIGRATE" --check 2>&1)"; then
	protokoll "$pruefung"
	endgueltig "Vorpruefung nicht bestanden."
fi
protokoll "Vorpruefung bestanden."

frei_kb="$(df -k /tmp | awk 'NR==2 {print $4}')"
[ -n "$frei_kb" ] || frei_kb=0
if [ "$frei_kb" -lt "$PLATZ_MIN_KB" ]; then
	spaeter "Nur $frei_kb kB frei in /tmp, gebraucht werden $PLATZ_MIN_KB kB."
fi

# --- Download ------------------------------------------------------------

# Zweig, Mirrors, Schluessel und Schwelle kommen aus der Konfiguration des
# Autoupdaters. Das Ziel laeuft damit mit dem Zweig des Knotens mit, und das
# Manifest muss dieselbe Pruefung bestehen wie bei jedem Update.
ZWEIG="$(uci -q get autoupdater.settings.branch)"
[ -n "$ZWEIG" ] || spaeter "Kein Autoupdater-Zweig gesetzt."
NAME="$(uci -q get "autoupdater.$ZWEIG.name")"
MIRRORS="$(uci -q get "autoupdater.$ZWEIG.mirror")"
SCHLUESSEL="$(uci -q get "autoupdater.$ZWEIG.pubkey")"
SCHWELLE="$(uci -q get "autoupdater.$ZWEIG.good_signatures")"
if [ -z "$NAME" ] || [ -z "$MIRRORS" ] || [ -z "$SCHLUESSEL" ] || [ -z "$SCHWELLE" ]; then
	spaeter "Autoupdater-Zweig $ZWEIG ist unvollstaendig."
fi

SHA=""
geladen=0
for mirror in $MIRRORS; do
	manifest_pruefen "$mirror" || continue
	image_holen "$mirror" || continue
	geladen=1
	break
done
[ "$geladen" = 1 ] || spaeter "Kein Mirror lieferte ein gueltiges Manifest samt Image."

# --- Uebergabe -----------------------------------------------------------
#
# Ab hier faengt erx-migrate.sh an zu schreiben. Es setzt selbst beide
# Waechter-Marker, sichert die Konfiguration, hebt darin die compat_version und
# uebergibt per "ubus call system sysupgrade" an Stufe 2 im RAM-Root.
#
# Die Uebergabedatei legt erx-migrate.sh unmittelbar davor an. Liegt sie, wenn
# der Aufruf zurueckkommt, hat der Abbau des Systems das Skript beendet: Stufe 2
# braucht das Image, also nichts mehr anfassen. Faellt die Uebergabe aus, raeumt
# erx-migrate.sh die Datei selbst wieder weg.

protokoll "Uebergebe an erx-migrate.sh."
rm -f "$UEBERGABE"
STAGE2="$STAGE2" SHA256="$SHA" UNBEAUFSICHTIGT=1 sh "$MIGRATE" "$IMAGE" >>"$LOG" 2>&1
rc=$?
[ -e "$UEBERGABE" ] && exit 0
protokoll "erx-migrate.sh kam mit $rc zurueck, ohne zu flashen."
endgueltig "Migration nicht durchgefuehrt, Einzelheiten oben."
