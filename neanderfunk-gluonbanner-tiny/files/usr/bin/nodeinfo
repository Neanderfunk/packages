#!/bin/sh
# nodeinfo [login|switch]
#   (none)  full status
#   login   the status block of the login banner (/etc/profile.gluon)
#   switch  the switch0 port line (/usr/bin/switch0)
# One copy of the status block for login, nodeinfo and switch0 (tiny: the
# login profile used to carry a second copy of this code).

sw() {
	echo switch0: $(swconfig dev switch0 show | grep 'link:'|sed -e 's/link://g' -e 's/port:/p/g' -e 's/speed://g' -e 's/baseT//g' -e 's/ full-duplex/fdx/g' -e 's/ half-duplex/hdx/g' -e 's/flow/f/g' -e 's/\t//g' -e 's/$/;/g' -e 's/ ;/;/g')
}
[ "$1" = switch ] && { sw; exit 0; }

summary() {
	echo -n "time='"$(date '+%A %d/%m/%Y %H:%M:%S')"'"
	[ -f /sys/class/net/bat0/mesh/hop_penalty ] && echo -n " - HopPenalty='$(cat /sys/class/net/bat0/mesh/hop_penalty|tr -d "\n")'"
	echo " - uptime='$(uptime|sed -e 's/^\ //1' -e 's/\ \ //g')'"
	batctl gwl
	imagename=$(lua -e 'print(require("platform_info").get_image_name())')
	# uci show once instead of ~15 times (login on 4/32 took 2 s)
	U="$(uci show 2>/dev/null)"
	MoLoff=$(echo "$U"|grep network.mesh_lan.disabled|cut -d"=" -f2)
	MoWoff=$(echo "$U"|grep network.mesh_wan.disabled|cut -d"=" -f2)
	ifMoL=$(echo "$U"|grep network.mesh_lan.ifname|cut -d"=" -f2)
	ifWAN=$(echo "$U"|grep network.wan.ifname|cut -d"=" -f2)
	ifCLI=$(echo "$U"|grep network.client.ifname|cut -d"=" -f2)
	lanCLI=\'$(echo $ifCLI|sed -r 's/.*(eth[0-9.]{1,3}).*/\1/g'|grep eth)\'
	batgw=$(batctl gwl|grep ^*|cut -d"[" -f2|cut -d"]" -f1)
	VPNon="'0'"
	[ "$(echo "$U"|grep gluon.mesh_vpn.enabled|cut -d"=" -f2)" == "'1'" ] && VPNon="'1'"
	[ "$(echo "$U"|grep tunneldigger.mesh_vpn.enabled|cut -d"=" -f2)" == "'1'" ] && VPNon="'1'"
	echo firmware=\'$(cat /lib/gluon/release)\'-\'$(cat /lib/gluon/gluon-version)\' autoupdater=$(echo "$U"|grep autoupdater.settings.enabled|cut -d"=" -f2) branch=$(echo "$U"|grep autoupdater.settings.branch|cut -d"=" -f2)
	echo vpn=$VPNon:$(echo "$U"|grep tunneldigger.mesh_vpn.enabled|cut -d"=" -f2|sed -e "s/'1'/l2tp/"|sed -e "s/'0'/l2tp_off/") $(echo "$U"|grep fastd.mesh_vpn.enabled|cut -d"=" -f2|sed -e "s/'1'/fastd/"|sed -e "s/'0'/fastd_off/") $(echo "$U"|grep simple-tc.mesh_vpn.enabled|cut -d"=" -f2|sed -e "s/'1'/\*BW-LIMITED!\*/"|sed -e "s/'0'//") - imagename=\'$imagename\' $([ $(head -c 4 /tmp/sysinfo/model)  = 'TP-L' ] &&(. /lib/ar71xx.sh ;. /lib/functions.sh ; echo \ HWID=\'$(tplink_get_hwid)\')) - $(df|grep "overlayfs"|awk '{print "overlayfs="$4"kB free, "$5" used"}')
	for r in 0 1 2; do echo "$U"|grep wireless.radio$r>/dev/null && (echo -n w$(echo "$U"|grep wireless.radio$r.disabled|cut -d"=" -f2)|sed -e "s/w'1'/Radio$r.OFF/"|sed -e "s/w'0'/Radio$r.ON/"|sed -e "s/w/Radio$r.ON/";echo \ r$r.ch=$(echo "$U"|grep radio$r.channel|cut -d"=" -f2) r$r.mode=$(echo "$U"|grep wireless.radio$r.htmode|cut -d"=" -f2) r$r.tx=\'$(iwinfo radio$r txpowerlist|grep "^*"|cut -d" " -f2)\' r$r.wifimesh-off=$(echo "$U"|grep wireless.mesh_radio$r.disabled|cut -d"=" -f2) r$r.ap-off=$(echo "$U"|grep wireless.client_radio$r.disabled|cut -d"=" -f2)); done
	echo -n "MoW.off=$MoWoff MoL.off=$MoLoff "
	[ "$MoLoff" == "'0'" ] && echo -n "MoL=$ifMoL "
	echo WAN=$ifWAN LANCLI=$lanCLI CLI=$ifCLI
	sw
	[ "$1" = login ] && echo "########################################### Contact:'$(echo "$U"|grep contact|cut -d= -f2)'"
	([ "$VPNon" == "'1'" ] && [ "$MoWoff" == "'0'" ]) && echo ALARM! MoW-VPN-Konflikt?
	# mesh on LAN and a LAN port in the client bridge at the same time
	([ "$MoLoff" == "'0'" ] && [ "$lanCLI" != "''" ]) && echo ALARM! MoL-CLI-Konflikt?
	([ "$VPNon" == "'1'" ] && [ ! $(echo "$batgw"|grep -i vpn) ]) && echo WARNING: VPN enabled, aber nicht verbunden?
}
[ "$1" = login ] && { summary login; exit 0; }

echo -n "### IP :  "
ifconfig |head|tail -n1
ip r s t all
echo    "### from ssh : "$SSH_CONNECTION
echo -n "### uptime :  "
uptime
[ -f /etc/init.d/fastd ] && (echo -n "### pubkey :  ";/etc/init.d/fastd show_key mesh_vpn)
[ -f /etc/init.d/tunneldigger ] && (echo -n "### tunneldigger :  ";ps|grep tunneldigger|head -1|cut -c 27-)
summary
iwinfo
echo -n "### connected to this node  :  "
batctl tl |grep W |wc -l
echo -n "### number of total clients :    "
batctl tg |grep W |wc -l
echo -n "### Location: Geo?:$(echo "$U"|grep .share_location=|cut -d= -f2)"
echo -n " lon:$(echo "$U"|grep .longitude=|cut -d= -f2)"
echo -n " lat:$(echo "$U"|grep .latitude=|cut -d= -f2)"
echo -n " Contact:$(echo "$U"|grep contact|cut -d= -f2)"
echo .
