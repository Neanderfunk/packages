# neanderfunk-hotfix
#
# Switch a single check off on this node:
#   uci set hotfix.<check>.disabled='1' ; uci commit hotfix
# The <check> name is part of the reason logged before a reboot or a wifi
# restart, so it can be read straight off `logread -f` while watching a node.

config settings 'settings'
	# No check may reboot the node within the first N minutes of uptime.
	# Deliberately not preset here: unset means the built-in default of 60,
	# and it lets the community preset a value from the site.conf (see
	# /lib/gluon/upgrade/500-neanderfunk-hotfix). Setting it here would
	# always win over the site.conf.
	#option reboot_uptime_min '60'

	# deadman watchdog for micrond itself: micrond starts watchdog.sh every
	# N minutes, an instance not relieved within 3*N minutes reboots the node.
	# Values below the period in /usr/lib/micron.d/hotfix (*/5) are raised to
	# it - a shorter deadline than the relief interval could never be met and
	# would reboot a healthy node.
	#option watchdog_interval_min '5'
	# how long a running autoupdater may go without relieving the watchdog
	# before it is considered stuck and the node is rebooted anyway
	#option autoupdater_stale_min '300'

# --- healthcheck.sh (*/7) ---
config check 'stale_lock'
config check 'kernel_bug'
config check 'ath_malloc'
config check 'ksoftirqd_malloc'
config check 'hostapd_pids'
config check 'dfs_failcheck'
config check 'tunneldigger'
config check 'br_client_ipv6'
config check 'load'
config check 'respondd'
config check 'dropbear'
config check 'bridge_ports'
config check 'mesh_neighbours'
config check 'watchdog'

# --- rebootIfNoGw.sh (*/8) ---
config check 'no_gateway'
config check 'ipv6_anycast'

# --- IfNoWificlient.sh (*/15) ---
config check 'no_wifi_clients'
