#!/bin/sh
# Sackgasse 2021.1: neanderfunk-migrate-updatebranch with the Sackgasse target
# branch - v2025.1.x maps old branches to 'stable', here everything goes to
# 'sackgasse' (the 4/32 devices have no newer release).

UPDATE_BRANCH=$(uci get autoupdater.settings.branch)

# shifting remaining gluon2021.x (32MB RAM/4MB Flash devices) from stable/beta/experimental/broken back to sackgasse systematically

if [ "$UPDATE_BRANCH" = "experimental" ] || [ "$UPDATE_BRANCH" = "broken" ] || [ "$UPDATE_BRANCH" = "experimentall2tp" ] || [ "$UPDATE_BRANCH" = "stablel2tp" ] || [ "$UPDATE_BRANCH" = "beta" ] || [ "$UPDATE_BRANCH" = "stable" ]; then
  uci set autoupdater.settings.branch='sackgasse'
 fi

# drop outdated update branches
uci -q delete autoupdater.experimental || true
uci -q delete autoupdater.stablel2tp || true
uci -q delete autoupdater.experimentall2tp || true
uci -q delete autoupdater.beta || true

