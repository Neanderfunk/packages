#!/usr/bin/lua
-- SPDX-License-Identifier: BSD-2-Clause
--
-- Writes /etc/config/nodeplacer from site.conf and installs the cron job.
-- Runs after 500-autoupdater because nodeplacer-fetch falls back to the
-- pubkeys of the configured autoupdater branch.

local site = require 'gluon.site'
local uci = require('simple-uci').cursor()

local cronfile = '/usr/lib/micron.d/nodeplacer'

-- Installed means active (D-042): without a nodeplacer block in site.conf,
-- or with parts of it missing, the defaults apply - the mirrors, keys and
-- threshold of the autoupdater branch the node is running, resolved at run
-- time by nodeplacer-fetch. site.nodeplacer.<key>() returns nil for a
-- missing block just like for a missing key.

-- mirrors, good_signatures and pubkeys are rewritten from site.conf on
-- every upgrade, like the autoupdater branch sections; where site.conf says
-- nothing, the option is removed so the fallback applies
uci:section('nodeplacer', 'nodeplacer', 'settings', {})

local mirrors = site.nodeplacer.mirrors()
if mirrors then
	uci:set('nodeplacer', 'settings', 'mirror', mirrors)
else
	uci:delete('nodeplacer', 'settings', 'mirror')
end

-- Keys and threshold are optional overrides as well (D-031).
local good_signatures = site.nodeplacer.good_signatures()
if good_signatures then
	uci:set('nodeplacer', 'settings', 'good_signatures', good_signatures)
else
	uci:delete('nodeplacer', 'settings', 'good_signatures')
end

local pubkeys = site.nodeplacer.pubkeys()
if pubkeys then
	uci:set('nodeplacer', 'settings', 'pubkey', pubkeys)
else
	uci:delete('nodeplacer', 'settings', 'pubkey')
end

-- 'disable' belongs to the node owner: only initialise it when unset
if uci:get('nodeplacer', 'settings', 'disable') == nil then
	local disable = site.nodeplacer.disable(0)
	if disable == true or disable == 1 then
		disable = '1'
	else
		disable = '0'
	end
	uci:set('nodeplacer', 'settings', 'disable', disable)
end

uci:save('nodeplacer')

-- one check per hour at a random minute (same idea as the autoupdater
-- fallback runs); the actual switch time is controlled by publishing the
-- manifest, not by the node
local urandom = io.open('/dev/urandom', 'r')
local seed1, seed2 = urandom:read(2):byte(1, 2)
math.randomseed(seed1 * 0x100 + seed2)
urandom:close()

local minute = math.random(0, 59)

local f = io.open(cronfile, 'w')
f:write(string.format('%i * * * * /usr/sbin/nodeplacer\n', minute))
f:close()
