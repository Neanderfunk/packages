#!/usr/bin/lua

local uci = require("simple-uci").cursor()

--- log to stdout (visible during a live gluon-reconfigure run) and syslog
local function log(message)
	print(message)
	os.execute('logger -s -t "neanderfunk-txpowerfix" -p 5 "' .. message .. '" 2>/dev/null')
end

--- wrapper for calling systemcommands
function cmd(_command)
	local f = io.popen(_command)
	local l = f:read("*a")
	f:close()
	return l
end

--- like cmd(), but for iwinfo/iw calls that can hang on some chipsets when
--- the radio is already up and meshing (this runs on every gluon-reconfigure,
--- not just once, so a live mesh radio is the normal case, not an edge case):
--- runs the command in the background and force-kills it after timeout_secs
--- if it hasn't finished on its own. Returns two values: a status ("OK" if
--- the command finished by itself, "TIMEOUT" if it had to be killed) and
--- whatever it managed to write to the temp file. The status matters
--- because an empty result can also legitimately mean "command finished
--- fine, there's just no matching line" (e.g. no txpower list for this
--- combination) rather than a hang - those two cases need different
--- handling by the caller.
function cmd_safe(_command, timeout_secs)
	local tmp = "/tmp/txpowerfix.out"
	local wrapped = string.format(
		'(%s) >%s 2>/dev/null & p=$!; sleep %d; ' ..
		'if kill -0 $p 2>/dev/null; then kill -9 $p 2>/dev/null; echo TIMEOUT; else echo OK; fi; ' ..
		'cat %s 2>/dev/null; rm -f %s',
		_command, tmp, timeout_secs, tmp, tmp)
	local result = cmd(wrapped)
	local status, rest = result:match('^(%a+)\n(.*)$')
	return status or 'OK', rest or ''
end

--- an empty txpowerlist result after a genuine timeout means the measurement
--- is actually stuck (or the tool hung) - that aborts the whole run rather
--- than committing a half-applied change. An empty result that finished on
--- its own just means this device/driver has no matching txpower entry for
--- the current settings, which is a legitimate outcome: log it and leave
--- txpower unset for this interface instead of aborting.
local function txpower_or_skip(interface)
	local status, t = cmd_safe(
		'iwinfo ' .. interface .. ' txpowerlist|grep mW|tr -d \'*\'|tail -n 1| awk \'{print $1}\'', 20)
	local maximumTxPowerDb = tonumber((t:gsub("\n", "")))
	if maximumTxPowerDb then
		return maximumTxPowerDb
	end
	if status == 'TIMEOUT' then
		log(interface .. ": txpowerlist timed out after 20s, aborting")
		os.exit(1)
	end
	log(interface .. ": no txpowerlist entry available, leaving txpower unset")
	return nil
end

--- same OK/TIMEOUT distinction as txpower_or_skip, but an empty htmodelist
--- match was already a legitimate, expected outcome even before that (no
--- HT/VHT/HE mode matches the filter for this device/regulatory-domain
--- combination) - so both cases just log and keep the HT20 default instead
--- of aborting; only the log message differs.
local function htmode_or_default(interface, grep_pattern)
	local status, VHT = cmd_safe(
		'iwinfo ' .. interface .. ' htmodelist|xargs -n1|grep -v "+"|grep -e "' .. grep_pattern .. '"|tail -n1|tr -d "\n"', 20)
	if VHT ~= '' and (string.match(VHT, 'HT') or string.match(VHT, 'HE')) then
		return VHT
	end
	if status == 'TIMEOUT' then
		log(interface .. ": htmodelist timed out after 20s, keeping HT20")
	else
		log(interface .. ": no htmode beyond HT20 found, keeping HT20")
	end
	return nil
end

--- Which radio is 2.4 GHz, which is 5 GHz?
---
--- This used to be worked out from the channel number: below 16 means 2.4,
--- above means 5, and "auto" was mapped to 999 - which put a 2.4 GHz radio set
--- to "auto" into the 5 GHz slot, and from there into the country and htmode
--- logic meant for 5 GHz. uci answers the question directly since OpenWrt
--- 21.02 replaced hwmode with band, so ask that instead; hwmode stays as the
--- older spelling. Measured on the test nodes: band is 2g/5g everywhere,
--- hwmode is empty.
---
--- Iterating the wifi-device sections also drops the old assumption that the
--- radios are exactly radio0 and radio1.
local interface24 = false
local interface50 = false

local function band_of(radio)
	local band = uci:get('wireless', radio, 'band')
	if band then
		return band
	end
	local hwmode = uci:get('wireless', radio, 'hwmode')
	if hwmode == '11g' or hwmode == '11b' then
		return '2g'
	elseif hwmode == '11a' then
		return '5g'
	end
	return nil
end

uci:foreach('wireless', 'wifi-device',
	function(section)
		local radio = section['.name']
		local band = band_of(radio)
		if band == '2g' and not interface24 then
			interface24 = radio
		elseif band == '5g' and not interface50 then
			interface50 = radio
		end
	end
)

if not interface24 and not interface50 then
	log("no 2.4GHz/5GHz radio found, nothing to do")
	os.exit(0)
end
log("detected interface24=" .. tostring(interface24) .. " interface50=" .. tostring(interface50))

--- determine country according to 5G

if interface24 then
	channel24 = uci:get('wireless', interface24, 'channel')
	if channel24 == '13' then
		country = 'JP'
	elseif channel24 == '12' then
		country = 'DE'
	else
		country = 'TW'
	end
end

if interface50 then
	channel50 = uci:get('wireless', interface50, 'channel')
	if channel50 == '32' or channel50 == '68' or channel50 == '169' or channel50 == '173' or channel50 == 'auto' or uci:get('gluon', 'wireless', 'outdoor') == '1' then
		country = 'DE'
	elseif channel50 == '138' or channel50 == '142' or channel50 == '144'  then
		country = 'US'
	else
		country = 'TW'
	end
end

if interface24 and interface50 then
	if channel24 == '13' then
		if channel50 == '32' or channel50 == '34' or channel50 == '68' or channel50 == '96' or channel50 == '138' or channel50 == '142' or channel50 == '144' or channel50 == '149' or channel50 == '151' or channel50 == '153' or channel50 == '155' or channel50 == '157' or channel50 == '159' or channel50 == '161' or channel50 == '165' or channel50 == '169' or channel50 == '173' or channel50 == 'auto' then
			country = 'DE'
		end
	end
end
log("chosen regulatory country=" .. tostring(country))

--- set HT-modes (1st pass)
local htmode24, htmode50, txpower24, txpower50 = nil, nil, nil, nil

if interface24 then
	uci:set('wireless', interface24, 'country', country)
	uci:save('wireless')
	uci:commit('wireless')
	cmd('/sbin/wifi reconf')
	htmode24 = 'HT20'
	uci:set('wireless', interface24, 'htmode', htmode24)
	local VHT = htmode_or_default(interface24, '20')
	if VHT then
		htmode24 = VHT
		uci:set('wireless', interface24, 'htmode', htmode24)
	end
end
if interface50 then
	-- an "interface50 == 'radio0' or 'radio1'" guard used to sit here. It was a
	-- sanity check on the hand-rolled detection above and would have skipped a
	-- third radio outright, so it is gone with that detection.
	if channel50 ~= 'auto' and uci:get('gluon', 'wireless', 'outdoor') ~= '1' then  --- don't do if outdoor is enabled
		uci:set('wireless', interface50, 'country', country)
		uci:save('wireless')
		uci:commit('wireless')
		cmd('/sbin/wifi reconf')
		local VHT = htmode_or_default(interface50, '80\\|40')
		if VHT then
			htmode50 = VHT
			uci:set('wireless', interface50, 'htmode', htmode50)
		end
	end
end
uci:save('wireless')
uci:commit('wireless')

--- restart with new ht modes
cmd('/sbin/wifi reconf')
cmd('sleep 5')

--- 2.4G
if interface24 then
	txpower24 = txpower_or_skip(interface24)
	if txpower24 then
		uci:set('wireless', interface24, 'txpower', txpower24)
	end
end

--- 5G
if interface50 then
	if channel50 ~= 'auto' and uci:get('gluon', 'wireless', 'outdoor') ~= '1' then  --- don't do if outdoor is enabled
		txpower50 = txpower_or_skip(interface50)
		if txpower50 then
			uci:set('wireless', interface50, 'txpower', txpower50)
		end
	else -- outdoors
		uci:set('wireless', interface50, 'country', country)
		uci:delete('wireless', interface50, 'txpower')
	end
end

--- restart stuff
uci:save('wireless')
uci:commit('wireless')
cmd('/sbin/wifi reconf')

log(string.format(
	"applied: country=%s 2.4GHz(%s)=htmode:%s,txpower:%s 5GHz(%s)=htmode:%s,txpower:%s",
	tostring(country),
	tostring(interface24), tostring(htmode24), tostring(txpower24),
	tostring(interface50), tostring(htmode50), tostring(txpower50)))
